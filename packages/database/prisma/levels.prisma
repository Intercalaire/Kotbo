model MemberLevel {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  lastXpGain DateTime @default(now())

  // Compteur du plafond `LevelConfig.dailyXpCap`, porté par la ligne du membre
  // plutôt que par une table dédiée : la cardinalité est la même et cette ligne
  // est déjà écrite à chaque gain, ce qui évite un second enregistrement à
  // purger. `dailyXpDate` est le jour UTC (YYYY-MM-DD) auquel `dailyXp` se
  // rapporte ; un jour différent vaut compteur remis à zéro.
  dailyXp     Int     @default(0)
  dailyXpDate String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, xp])
  @@map("member_levels")
}

model LevelRoleReward {
  id       String @id @default(cuid())
  guildId  String
  level    Int
  roleId   String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, level])
  @@map("level_role_rewards")
}

model LevelConfig {
  guildId         String   @id
  enabled         Boolean  @default(false)
  xpMin           Int      @default(15)
  xpMax           Int      @default(25)
  cooldownSeconds Int      @default(60)
  vocalXpPerMin   Int      @default(5)
  levelUpChannelId String?  // null = same channel, "DM" = DM, or specific channel ID
  levelUpMessage  String   @default("Félicitations {user} ! Tu passes au niveau **{level}** ! 🎉")
  stackRewards    Boolean  @default(false)
  ignoredChannels String[] @default([])
  ignoredRoles    String[] @default([])
  xpMultipliers   Json?

  // Bonus d'XP selon la longueur du message : plus un message est long, plus
  // le gain est multiplié, jusqu'à `lengthBonusMaxMultiplier` atteint à
  // `lengthBonusThreshold` caractères (progression linéaire, plafonnée).
  lengthBonusEnabled       Boolean @default(false)
  lengthBonusThreshold     Int     @default(200)
  lengthBonusMaxMultiplier Float   @default(2.0)

  // Courbe d'XP : `curveBaseXp * niveau^curveExponent + curveLinearXp * niveau`.
  // Les valeurs par défaut reproduisent la courbe historique codée en dur, pour
  // que l'activation du réglage ne déplace aucun niveau existant.
  curveBaseXp    Int   @default(100)
  curveLinearXp  Int   @default(200)
  curveExponent  Float @default(2.0)
  /// 0 = pas de plafond de niveau.
  maxLevel       Int   @default(0)

  // Conditions d'attribution de l'XP vocale.
  voiceRequireUnmuted    Boolean @default(true)
  voiceRequireUndeafened Boolean @default(true)
  voiceIgnoreAfkChannel  Boolean @default(true)
  /// Nombre minimum d'humains connectés au salon pour que l'XP soit accordée.
  voiceMinMembers        Int     @default(1)

  /// Plafond d'XP gagnable par jour et par membre. 0 = illimité.
  dailyXpCap Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("level_configs")
}

model AutoLeaderboard {
  id        String  @id @default(cuid())
  guildId   String
  channelId String
  messageId String?
  type      String  // "messages" | "voice" | "mixed" | "xp"
  style     String  @default("image") // "image" | "embed"
  periodDays Int    @default(30)
  enabled   Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId, type])
  @@map("auto_leaderboards")
}

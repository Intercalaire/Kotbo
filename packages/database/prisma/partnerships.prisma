// ============================================================================
// PARTENARIATS
// ============================================================================
//
// Ne pas confondre avec `partnership.prisma` (au singulier), qui traite des
// candidatures adressées à Kotbo lui-même via le formulaire du dashboard. Ce
// fichier-ci porte le module Partenariats : l'outil avec lequel une communauté
// gère ses propres partenariats, et avec lequel l'équipe Kotbo gère les siens.
//
// ── Pourquoi un seul moteur pour les deux ───────────────────────────────────
//
// Un partenariat de serveur et un partenariat Kotbo portent les mêmes champs,
// le même cycle de vie et les mêmes engagements. `scope` distingue les deux :
// `GUILD` pour un serveur client (`guildId` renseigné), `PLATFORM` pour Kotbo
// (`guildId` nul, administration globale). C'est la seule différence, et elle
// ne se paie pas par une seconde arborescence de tables à maintenir en double.
//
// ── Pourquoi `type`, `tier` et `stage` sont des `String` ────────────────────
//
// Les trois axes du module vivent dans `@kotbo/contracts` (`partnerships.ts`)
// et bougent à chaque type de partenariat ajouté. Un `enum` Prisma imposerait
// une migration pour chacun ; la validation se fait à l'entrée, par
// `isPartnershipType`, `isPartnershipTier` et `isPartnershipStage`. Les états
// réellement clos - une partie à un accord, un statut de paiement - restent
// des `enum`, eux ne bougeront pas.
//
// ── Deux serveurs, deux dossiers ────────────────────────────────────────────
//
// Quand les deux communautés ont Kotbo, chacune garde SON `Partnership` : ses
// notes, son responsable, ses avantages. `PartnershipBridge` relie les deux et
// synchronise ce qui doit l'être (étape, accord, engagements). Un dossier
// partagé unique aurait obligé à arbitrer qui peut écrire quoi, et aurait fait
// fuiter les notes internes d'une équipe vers l'autre.

// ─────────────────────────────── Énumérations ───────────────────────────────

/// Portée d'un dossier : serveur client ou plateforme Kotbo.
enum PartnershipScope {
  GUILD
  PLATFORM
}

/// Qui s'engage. `US` est toujours le détenteur du dossier, jamais l'autre :
/// vu depuis le serveur d'en face, les rôles s'inversent.
enum PartnershipParty {
  US
  PARTNER
  BOTH
}

/// Sens d'un avantage : accordé par nous, ou reçu du partenaire.
enum PartnershipDirection {
  GRANTED
  RECEIVED
}

enum PartnershipBenefitState {
  /// Décidé, pas encore appliqué (partenariat pas encore actif).
  PLANNED
  APPLIED
  /// Appliqué puis retiré normalement, à la fin du partenariat.
  REVOKED
  /// L'application a échoué (rôle supprimé, permissions manquantes).
  FAILED
}

enum PartnershipCommitmentState {
  PENDING
  ON_TRACK
  AT_RISK
  BREACHED
  FULFILLED
  WAIVED
}

enum PartnershipPaymentStatus {
  SCHEDULED
  DUE
  RECEIVED
  LATE
  WAIVED
  REFUNDED
}

enum PartnershipProposalStatus {
  SENT
  SEEN
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum PartnerApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  SPAM
}

enum PartnershipReciprocityResult {
  OK
  MISSING
  ALTERED
  UNREACHABLE
}

enum PartnershipAgreementState {
  DRAFT
  PROPOSED
  ACCEPTED
  SUPERSEDED
  WITHDRAWN
}

// ─────────────────────────────── Configuration ──────────────────────────────

/// Réglages du module, un par serveur.
///
/// Tout ce qui est automatique ici est désactivé par défaut : le module touche
/// à des rôles, des salons et des exemptions d'automod. Un réglage qui
/// s'activerait seul retirerait un jour un rôle que personne n'a demandé de
/// retirer.
model PartnershipSettings {
  guildId String @id

  enabled Boolean @default(false)

  // ── Niveau de formalisme ──────────────────────────────────────────────────
  /// Niveau proposé à la création quand le type n'en impose pas d'autre.
  defaultTier String @default("PIPELINE")
  /// Validation par une seconde personne avant activation, quel que soit le
  /// niveau. Les dossiers financiers l'exigent de toute façon.
  requireDualApproval Boolean @default(false)

  // ── Salons et rôles ───────────────────────────────────────────────────────
  /// Salon de travail du staff : demandes, validations, alertes.
  staffChannelId String?
  /// Salon vitrine où les fiches partenaires sont publiées et tenues à jour.
  showcaseChannelId String?
  /// Salon où sont publiées les publicités des partenaires.
  adsChannelId String?
  /// Catégorie sous laquelle créer les salons dédiés.
  dedicatedCategoryId String?
  /// Rôle donné aux représentants des partenaires actifs.
  partnerRoleId String?
  /// Rôle donné aux membres arrivés par un partenaire, s'il y en a un.
  referredRoleId String?

  // ── Candidatures ──────────────────────────────────────────────────────────
  applicationsOpen Boolean @default(false)
  /// Formulaire personnalisé servant de dossier de candidature.
  applicationFormId String?
  /// Type de ticket ouvert pour instruire une candidature.
  applicationTicketTypeId String?
  /// Effectif minimal exigé d'un serveur candidat. 0 = pas de seuil.
  minMemberCount Int @default(0)
  /// Ancienneté minimale du serveur candidat, en jours.
  minServerAgeDays Int @default(0)
  /// Refus automatique des candidatures ne tenant pas ces seuils, avec motif.
  autoRejectBelowThreshold Boolean @default(false)

  // ── Automatismes ──────────────────────────────────────────────────────────
  /// Publier et faire tourner les publicités des partenaires actifs.
  autoPublishAds Boolean @default(false)
  /// Intervalle de rotation de la vitrine, en heures. 0 = pas de rotation.
  adRotationHours Int @default(0)
  /// Vérifier que notre publicité est toujours en place chez le partenaire.
  reciprocityChecks Boolean @default(false)
  /// Fréquence de ce contrôle, en heures.
  reciprocityIntervalHours Int @default(24)
  /// Nombre de contrôles négatifs consécutifs avant de considérer l'engagement
  /// rompu. Deux par défaut : une suppression accidentelle arrive, deux fois de
  /// suite non.
  reciprocityGraceCount Int @default(2)
  /// Appliquer et retirer les avantages automatiquement aux changements d'étape.
  autoApplyBenefits Boolean @default(true)
  /// Rompre automatiquement un partenariat dont un engagement reste non tenu.
  /// Éteint par défaut : une rupture est une décision, pas un effet de bord.
  autoBreachOnFailure Boolean @default(false)
  /// Jours avant échéance à partir desquels un dossier passe en renouvellement.
  renewalNoticeDays Int @default(14)
  /// Archiver les dossiers terminés après ce délai, en jours. 0 = jamais.
  autoArchiveAfterDays Int @default(0)

  // ── Mesure ────────────────────────────────────────────────────────────────
  /// Créer une invitation Discord dédiée par partenariat pour l'attribution.
  trackInvites Boolean @default(true)
  /// Suivre l'activité des membres amenés, pas seulement leur nombre.
  trackReferredActivity Boolean @default(true)
  /// Fenêtre de mesure de la rétention, en jours.
  retentionWindowDays Int @default(30)

  // ── Notifications ─────────────────────────────────────────────────────────
  notifyStaffChannel Boolean @default(true)
  notifyDashboard    Boolean @default(true)
  /// Message privé au responsable du dossier pour ce qui le concerne.
  notifyOwnerDm      Boolean @default(false)
  /// Bilan périodique : `none` | `weekly` | `monthly`.
  digestFrequency    String  @default("weekly")
  digestChannelId    String?
  /// Rôles mentionnés par les alertes du module.
  alertRoleIds       String[] @default([])

  // ── Annuaire Kotbo ────────────────────────────────────────────────────────
  /// Référencement du serveur dans l'annuaire inter-serveurs. Strictement
  /// opt-in : rien n'est publié tant que personne n'a coché.
  directoryOptIn Boolean @default(false)
  /// Accepter de recevoir des propositions de partenariat par l'annuaire.
  directoryAcceptProposals Boolean @default(true)
  /// Suggestions automatiques de partenaires compatibles.
  matchmakingEnabled Boolean @default(false)

  // ── Réputation partagée ───────────────────────────────────────────────────
  /// Contribuer des signalements au réseau. Opt-in, et sans effet automatique :
  /// un signal reçu s'affiche, il ne refuse jamais un partenariat tout seul.
  reputationShare   Boolean @default(false)
  /// Consulter les signaux du réseau lors d'une nouvelle demande.
  reputationConsume Boolean @default(false)

  // ── Finance ───────────────────────────────────────────────────────────────
  financeEnabled Boolean @default(false)
  /// Devise des montants, en ISO 4217. Purement déclaratif : Kotbo
  /// n'encaisse rien pour le compte d'un serveur.
  currency String @default("EUR")
  /// Jours avant échéance pour le rappel de paiement.
  paymentReminderDays Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("partnership_settings")
}

// ─────────────────────────────── Fiche partenaire ───────────────────────────

/// Qui est en face. Séparé de `Partnership` parce qu'un même partenaire peut
/// enchaîner plusieurs accords - un échange de pubs, puis un événement, puis
/// un sponsor - et qu'il serait absurde de ressaisir sa fiche à chaque fois.
/// C'est aussi ce qui permet de dire « troisième partenariat avec eux, les
/// deux précédents tenus » au moment de décider.
model Partner {
  id      String           @id @default(cuid())
  scope   PartnershipScope @default(GUILD)
  /// Serveur propriétaire de la fiche. Nul pour les partenaires de Kotbo.
  guildId String?

  /// SERVER | PERSON | ORGANIZATION, cf. `PARTNER_KINDS`.
  kind String @default("SERVER")

  displayName String
  /// Nom court utilisé dans les listes et les embeds.
  shortName   String?
  description String?
  /// Thèmes libres : gaming, entraide, francophone… Sert au matchmaking.
  tags        String[] @default([])
  locale      String?
  timezone    String?

  // ── Identité Discord ──────────────────────────────────────────────────────
  /// Identifiant du serveur partenaire. Non contraint vers `Guild` : la plupart
  /// des partenaires n'ont pas Kotbo, et ceux qui l'ont peuvent le retirer sans
  /// que leur fiche doive disparaître.
  partnerGuildId String?
  /// Invitation permanente vers leur serveur, vérifiée périodiquement.
  inviteUrl      String?
  inviteCheckedAt DateTime?
  /// Dernier état constaté de cette invitation : `valid` | `expired` | `unknown`.
  inviteState    String?
  iconUrl        String?
  bannerUrl      String?
  /// Couleur d'accent des embeds de ce partenaire, en `#rrggbb`.
  accentColor    String?

  // ── Audience ──────────────────────────────────────────────────────────────
  memberCount        Int?
  memberCountAt      DateTime?
  /// Audience hors Discord déclarée (abonnés, vues moyennes).
  externalAudience   Int?
  /// Liens externes : site, réseaux, chaînes. `[{ label, url }]`.
  links              Json?

  // ── Suivi interne ─────────────────────────────────────────────────────────
  /// Score de confiance consolidé, 0 à 100. Calculé à partir de l'historique
  /// des dossiers et des engagements tenus, jamais saisi à la main.
  trustScore Int @default(50)
  /// Fiche bloquée : aucune nouvelle proposition possible, avec motif.
  blocked       Boolean @default(false)
  blockedReason String?
  blockedAt     DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild        Guild?                 @relation(fields: [guildId], references: [id], onDelete: Cascade)
  contacts     PartnerContact[]
  partnerships Partnership[]
  applications PartnerApplication[]
  reports      PartnerReputationReport[]

  @@index([guildId, kind])
  @@index([guildId, displayName])
  @@index([partnerGuildId])
  @@index([scope, blocked])
  @@map("partners")
}

/// Les gens à qui l'on parle chez le partenaire.
///
/// Plusieurs par fiche, parce qu'un partenariat qui ne tient qu'à un seul
/// interlocuteur meurt le jour où il quitte son serveur - cas assez fréquent
/// pour mériter une table.
model PartnerContact {
  id        String @id @default(cuid())
  partnerId String

  /// Identifiant Discord, quand la personne est joignable sur Discord.
  userId      String?
  displayName String
  /// Rôle chez le partenaire : `owner` | `manager` | `staff` | `creator`.
  role        String @default("manager")
  /// Interlocuteur principal. Un seul par fiche, tenu par le service.
  primary     Boolean @default(false)
  /// Contact hors Discord (courriel, réseau), en clair et volontairement libre.
  externalContact String?
  notes           String?

  /// Reçoit le rôle partenaire et les accès accordés par les avantages.
  representative Boolean @default(true)
  /// Dernière fois où la personne a été vue sur notre serveur. Sert à
  /// l'engagement « représentant présent ».
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([userId])
  @@map("partner_contacts")
}

// ─────────────────────────────── Le dossier ─────────────────────────────────

/// Un partenariat : la relation elle-même, avec son type, son niveau de
/// formalisme et son état.
model Partnership {
  id        String           @id @default(cuid())
  scope     PartnershipScope @default(GUILD)
  guildId   String?
  partnerId String

  /// Cf. `PARTNERSHIP_TYPES`.
  type  String
  /// SIMPLE | PIPELINE | CONTRACT, cf. `PARTNERSHIP_TIERS`.
  tier  String @default("PIPELINE")
  /// Cf. `PARTNERSHIP_STAGES`.
  stage String @default("LEAD")

  title       String?
  summary     String?
  /// Conditions en texte libre, pour les dossiers qui ne formalisent rien.
  terms       String?
  /// Priorité de traitement, 0 à 3. Remonte les dossiers en tête de pipeline.
  priority    Int     @default(1)

  // ── Calendrier ────────────────────────────────────────────────────────────
  startAt   DateTime?
  endAt     DateTime?
  /// Reconduction tacite à l'échéance, sauf dénonciation.
  autoRenew Boolean   @default(false)
  /// Durée de reconduction, en jours.
  renewDays Int?

  // ── Responsabilité ────────────────────────────────────────────────────────
  /// Membre du staff qui porte le dossier. Les relances lui sont adressées.
  ownerUserId    String?
  approvedByUserId String?
  approvedAt     DateTime?
  /// Seconde validation, quand le niveau l'exige.
  secondApprovedByUserId String?
  secondApprovedAt DateTime?

  // ── Fin ───────────────────────────────────────────────────────────────────
  endedAt      DateTime?
  endedByUserId String?
  /// Motif de rupture. Obligatoire pour passer en `BREACHED`, c'est ce qui
  /// nourrit la réputation du partenaire et le retour d'expérience.
  endReason    String?

  // ── Ressources créées pour ce dossier ─────────────────────────────────────
  /// Salon dédié, s'il en a été créé un. Archivé, jamais supprimé, à la fin.
  dedicatedChannelId String?
  /// Fil ou ticket de négociation.
  ticketId           String?
  /// Message de vitrine publié dans le salon annuaire, tenu à jour.
  showcaseMessageId  String?

  // ── Mesure ────────────────────────────────────────────────────────────────
  /// Code d'invitation dédié : l'attribution des arrivées repose dessus.
  inviteCode      String?
  /// Compteurs consolidés, tenus par le service de mesure. Dupliqués ici pour
  /// que la liste du pipeline s'affiche sans agréger `PartnershipMetricDaily`
  /// à chaque ligne.
  referredJoins   Int @default(0)
  referredLeaves  Int @default(0)
  referredActive  Int @default(0)
  /// Santé du dossier, 0 à 100 : engagements tenus, réciprocité, apport réel.
  healthScore     Int @default(50)
  healthComputedAt DateTime?

  // ── Finance ───────────────────────────────────────────────────────────────
  /// Montant convenu, en centimes, dans la devise du serveur. Positif quand
  /// l'argent vient à nous, négatif quand il en part.
  amountCents  Int?
  /// `once` | `monthly` | `yearly` | `per_event`.
  amountPeriod String?

  /// Champs libres ajoutés par le serveur à son modèle de fiche.
  customFields Json?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild       Guild?       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  agreements   PartnershipAgreement[]
  commitments  PartnershipCommitment[]
  benefits     PartnershipBenefit[]
  promotions   PartnershipPromotion[]
  checks       PartnershipReciprocityCheck[]
  links        PartnershipTrackedLink[]
  referrals    PartnershipReferral[]
  metrics      PartnershipMetricDaily[]
  events       PartnershipEvent[]
  notes        PartnershipNote[]
  documents    PartnershipDocument[]
  payments     PartnershipPayment[]
  guestAccess  PartnershipGuestAccess[]
  bridgeAsLocal  PartnershipBridge[] @relation("BridgeLocal")
  bridgeAsRemote PartnershipBridge[] @relation("BridgeRemote")

  @@index([guildId, stage])
  @@index([guildId, type])
  @@index([partnerId])
  @@index([stage, endAt])
  @@index([ownerUserId])
  @@index([inviteCode])
  @@map("partnerships")
}

/// Le lien entre les deux dossiers quand les deux serveurs ont Kotbo.
///
/// Chaque côté garde le sien ; ce pont dit qu'ils parlent du même accord et
/// porte ce qui doit rester identique de part et d'autre. `syncedFields`
/// énumère ce que le côté distant a accepté de synchroniser : sans cette
/// liste, synchroniser l'étape reviendrait à laisser l'autre équipe changer
/// l'état d'un dossier qu'elle ne possède pas.
model PartnershipBridge {
  id String @id @default(cuid())

  localPartnershipId  String
  remotePartnershipId String
  localGuildId        String
  remoteGuildId       String

  /// Confirmé par les deux côtés. Un pont non confirmé n'échange rien.
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?

  /// `stage` | `agreement` | `commitments` | `promotions`, au choix des deux.
  syncedFields String[] @default([])
  lastSyncAt   DateTime?
  /// Dernière erreur de synchronisation, pour ne pas la répéter en silence.
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  local  Partnership @relation("BridgeLocal", fields: [localPartnershipId], references: [id], onDelete: Cascade)
  remote Partnership @relation("BridgeRemote", fields: [remotePartnershipId], references: [id], onDelete: Cascade)

  @@unique([localPartnershipId, remotePartnershipId])
  @@index([remoteGuildId])
  @@map("partnership_bridges")
}

// ─────────────────────────────── Accord versionné ───────────────────────────

/// Une version de l'accord. On ne modifie jamais une version acceptée : on en
/// propose une nouvelle, qui rend la précédente `SUPERSEDED`. Sans cela, « ce
/// qui avait été convenu » se réécrirait après coup, et la discussion sur un
/// engagement non tenu n'aurait plus d'arbitre.
model PartnershipAgreement {
  id            String @id @default(cuid())
  partnershipId String

  version Int
  state   PartnershipAgreementState @default(DRAFT)

  /// Corps de l'accord, en texte. Ce que les engagements structurés ne disent
  /// pas y reste lisible.
  body String

  /// Instantané des engagements au moment de la proposition. Les engagements
  /// vivants restent dans `PartnershipCommitment` ; cette copie fige ce qui a
  /// été accepté.
  commitmentsSnapshot Json?

  proposedByUserId String?
  proposedAt       DateTime?

  /// Acceptation de chaque partie, horodatée. Côté partenaire, l'acceptation
  /// peut venir du dashboard s'il a Kotbo, ou du portail invité sinon.
  acceptedByUs        Boolean   @default(false)
  acceptedByUsAt      DateTime?
  acceptedByUsUserId  String?
  acceptedByPartner   Boolean   @default(false)
  acceptedByPartnerAt DateTime?
  /// Qui a accepté en face : identifiant Discord, ou jeton du portail invité.
  acceptedByPartnerRef String?

  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, version])
  @@index([partnershipId, state])
  @@map("partnership_agreements")
}

// ─────────────────────────────── Engagements ────────────────────────────────

/// Ce que chaque partie a promis, et où elle en est.
model PartnershipCommitment {
  id            String @id @default(cuid())
  partnershipId String

  party PartnershipParty @default(PARTNER)
  /// Cf. `PARTNERSHIP_COMMITMENT_KINDS`.
  kind  String
  label String?

  /// Quantité attendue par période, pour les engagements chiffrés.
  targetCount  Int?
  /// `day` | `week` | `month` | `total`.
  targetPeriod String?
  /// Salon, rôle ou montant concerné, selon le genre d'engagement.
  targetRef    String?

  state PartnershipCommitmentState @default(PENDING)
  /// Nombre d'échecs constatés d'affilée. Remis à zéro dès qu'une période est
  /// tenue : c'est la répétition qui fait la rupture, pas l'accident.
  failureStreak Int @default(0)
  lastCheckedAt DateTime?

  /// Pointé à la main, pour les engagements non mesurables.
  manualState     PartnershipCommitmentState?
  manualByUserId  String?
  manualAt        DateTime?
  manualNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnership Partnership                   @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  periods     PartnershipCommitmentPeriod[]

  @@index([partnershipId, state])
  @@index([state, lastCheckedAt])
  @@map("partnership_commitments")
}

/// Le relevé période par période d'un engagement chiffré.
///
/// Garder l'historique plutôt qu'un seul compteur courant : « ils ont tenu
/// leurs trois publications ce mois-ci » ne dit rien ; « quatre mois sur six »
/// décide d'un renouvellement.
model PartnershipCommitmentPeriod {
  id           String @id @default(cuid())
  commitmentId String

  periodStart DateTime
  periodEnd   DateTime

  expected Int @default(0)
  achieved Int @default(0)

  state PartnershipCommitmentState @default(PENDING)
  /// Ce qui a permis de conclure : identifiants de messages, contrôles,
  /// arrivées comptées. Sert à justifier une rupture contestée.
  evidence Json?

  closedAt DateTime?

  commitment PartnershipCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@unique([commitmentId, periodStart])
  @@index([commitmentId, state])
  @@map("partnership_commitment_periods")
}

// ─────────────────────────────── Avantages ──────────────────────────────────

/// Un avantage décidé pour ce partenariat, dans un sens ou dans l'autre.
model PartnershipBenefit {
  id            String @id @default(cuid())
  partnershipId String

  direction PartnershipDirection @default(GRANTED)
  /// Cf. `PARTNERSHIP_BENEFIT_KINDS`.
  kind      String
  label     String?

  /// Cible de l'avantage : rôle, salon, montant, taux. Le genre d'avantage dit
  /// comment la lire.
  targetRef   String?
  /// Paramètres additionnels : multiplicateur, durée, quantité.
  params      Json?

  state PartnershipBenefitState @default(PLANNED)
  /// Motif du dernier échec d'application, quand `state` vaut `FAILED`.
  lastError String?

  appliedAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnership Partnership              @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  grants      PartnershipBenefitGrant[]

  @@index([partnershipId, state])
  @@map("partnership_benefits")
}

/// L'application effective d'un avantage à une personne ou à une ressource.
///
/// Sans cette trace, retirer proprement un avantage serait impossible : on ne
/// saurait pas si le rôle a été donné par le partenariat ou par quelqu'un
/// d'autre, et on retirerait à la fin un rôle que la personne avait déjà.
model PartnershipBenefitGrant {
  id        String @id @default(cuid())
  benefitId String

  /// Bénéficiaire : identifiant Discord d'un membre, ou d'un salon.
  subjectId   String
  /// `member` | `channel` | `role`.
  subjectType String @default("member")

  /// Vrai si la ressource existait déjà avant nous. Dans ce cas, la révocation
  /// ne touche à rien.
  preExisting Boolean @default(false)

  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  /// Motif de révocation : `partnership_ended` | `benefit_removed` | `manual`.
  revokeReason String?

  benefit PartnershipBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([benefitId, subjectId])
  @@index([subjectId, revokedAt])
  @@map("partnership_benefit_grants")
}

// ─────────────────────────────── Publicités ─────────────────────────────────

/// La publicité d'un partenariat : le contenu à publier, et où.
model PartnershipPromotion {
  id            String @id @default(cuid())
  partnershipId String

  /// `INBOUND` : leur publicité chez nous. `OUTBOUND` : la nôtre chez eux.
  direction PartnershipDirection @default(GRANTED)

  title     String?
  content   String?
  /// Embed normalisé : titre, description, image, couleur.
  embed     Json?
  imageUrl  String?
  inviteUrl String?

  /// Salon de publication chez nous. Nul pour une publicité sortante.
  channelId String?
  /// Salon de publication chez eux, tel qu'ils l'ont indiqué. Sert au contrôle
  /// de réciprocité quand les deux serveurs ont Kotbo.
  remoteChannelId String?

  /// Publication automatique et rotation dans la vitrine.
  autoPublish Boolean @default(false)
  /// Périodicité de republication, en heures. 0 = une seule publication.
  repeatHours Int     @default(0)
  /// Supprimer la publication précédente avant d'en poster une nouvelle, pour
  /// ne pas empiler dix publicités du même partenaire dans le salon.
  replacePrevious Boolean @default(true)

  lastPostedAt DateTime?
  nextPostAt   DateTime?
  postCount    Int       @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnership Partnership                @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  posts       PartnershipPromotionPost[]

  @@index([partnershipId, active])
  @@index([active, nextPostAt])
  @@map("partnership_promotions")
}

/// Une publication effective. C'est la preuve qui sert à mesurer l'engagement
/// « N publications par mois » et à retrouver le message à supprimer.
model PartnershipPromotionPost {
  id          String @id @default(cuid())
  promotionId String

  guildId   String
  channelId String
  messageId String

  postedAt  DateTime  @default(now())
  deletedAt DateTime?
  /// Qui a supprimé : `bot_rotation` | `moderator` | `unknown`.
  deletedBy String?

  /// Compteurs relevés à la dernière vérification.
  reactionCount Int @default(0)

  promotion PartnershipPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, postedAt])
  @@index([messageId])
  @@map("partnership_promotion_posts")
}

/// Un contrôle de réciprocité : notre publicité est-elle toujours en place ?
model PartnershipReciprocityCheck {
  id            String @id @default(cuid())
  partnershipId String

  checkedAt DateTime                     @default(now())
  result    PartnershipReciprocityResult

  /// Salon inspecté et message attendu, quand ils sont connus.
  remoteChannelId String?
  remoteMessageId String?
  /// Comment le contrôle a été fait : `bridge` (Kotbo des deux côtés),
  /// `observed` (le bot voit le salon), `manual` (pointé par le staff).
  method String @default("bridge")
  detail String?

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, checkedAt])
  @@map("partnership_reciprocity_checks")
}

// ─────────────────────────────── Mesure ─────────────────────────────────────

/// Lien traçable pour ce qui ne passe pas par une invitation Discord.
model PartnershipTrackedLink {
  id            String @id @default(cuid())
  partnershipId String

  /// Fragment d'URL, unique par instance. Court, lisible, non devinable.
  slug        String
  targetUrl   String
  label       String?

  clickCount  Int @default(0)
  uniqueCount Int @default(0)
  /// Arrivées sur le serveur observées dans la foulée d'un clic.
  conversions Int @default(0)

  active    Boolean   @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@unique([slug])
  @@index([partnershipId, active])
  @@map("partnership_tracked_links")
}

/// Un membre arrivé, attribué à un partenariat.
///
/// La table ne garde aucune donnée de contenu : un identifiant, des dates, et
/// de quoi dire si la personne est restée. C'est ce qui permet de distinguer
/// un partenaire qui apporte des membres actifs d'un partenaire qui apporte
/// des comptes qui repartent le lendemain.
model PartnershipReferral {
  id            String @id @default(cuid())
  partnershipId String

  userId  String
  guildId String

  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  /// Toujours présent à la fin de la fenêtre de rétention.
  retained Boolean   @default(false)

  /// Activité constatée pendant la fenêtre : messages, minutes en vocal,
  /// niveau atteint. Nourrit la qualité, pas seulement le volume.
  messageCount Int @default(0)
  voiceMinutes Int @default(0)
  levelReached Int @default(0)
  /// Sanctions reçues. Un partenaire dont les arrivants se font sanctionner
  /// coûte plus qu'il ne rapporte, et le score doit pouvoir le dire.
  sanctionCount Int @default(0)

  /// Comment l'attribution a été faite : `invite` | `link` | `manual`.
  attribution String @default("invite")

  updatedAt DateTime @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, userId])
  @@index([guildId, joinedAt])
  @@index([partnershipId, retained])
  @@map("partnership_referrals")
}

/// Agrégat quotidien par partenariat. Une ligne par jour et par dossier :
/// les vues de tendance ne rescannent pas les arrivées une à une.
model PartnershipMetricDaily {
  id            String @id @default(cuid())
  partnershipId String

  /// YYYY-MM-DD, dans le fuseau du serveur. Le process tourne en UTC : sans
  /// fuseau de référence explicite, la frontière du jour se déplacerait deux
  /// fois par an.
  dateKey String

  joins     Int @default(0)
  leaves    Int @default(0)
  retained  Int @default(0)
  messages  Int @default(0)
  clicks    Int @default(0)
  adPosts   Int @default(0)
  /// Montant reçu ou versé ce jour-là, en centimes.
  amountCents Int @default(0)

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, dateKey])
  @@index([dateKey])
  @@map("partnership_metric_daily")
}

// ─────────────────────────────── Journal et pièces ──────────────────────────

/// La chronologie du dossier : chaque changement d'étape, chaque échange,
/// chaque automatisme déclenché. C'est ce qui permet de reprendre un dossier
/// qu'on n'a pas suivi, et de comprendre pourquoi un partenariat a tourné.
model PartnershipEvent {
  id            String @id @default(cuid())
  partnershipId String

  /// `stage_changed` | `message` | `benefit_applied` | `commitment_failed`…
  kind    String
  /// Résumé lisible, déjà formulé pour l'affichage.
  summary String
  /// Détail structuré : ancienne et nouvelle étape, identifiants concernés.
  payload Json?

  /// Auteur. Nul quand c'est le bot.
  actorUserId String?
  /// `dashboard` | `discord` | `bot` | `guest_portal` | `bridge`.
  source      String @default("bot")

  createdAt DateTime @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, createdAt])
  @@index([kind, createdAt])
  @@map("partnership_events")
}

/// Note interne. Jamais visible du partenaire, y compris par le portail invité.
model PartnershipNote {
  id            String @id @default(cuid())
  partnershipId String

  body        String
  authorUserId String?
  /// Note épinglée en tête du dossier.
  pinned      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, createdAt])
  @@map("partnership_notes")
}

/// Pièce jointe : contrat signé, facture, visuel fourni, capture de preuve.
///
/// Le fichier n'est pas stocké par Kotbo : on garde l'URL - pièce jointe
/// Discord ou lien externe - et de quoi la décrire. Héberger des fichiers
/// arbitraires ouvrirait une surface de stockage et d'analyse que le module
/// n'a pas besoin d'ouvrir.
model PartnershipDocument {
  id            String @id @default(cuid())
  partnershipId String

  label    String
  url      String
  /// `contract` | `invoice` | `asset` | `proof` | `other`.
  category String @default("other")
  mimeType String?
  sizeBytes Int?

  /// Visible du partenaire via le portail invité.
  sharedWithPartner Boolean @default(false)

  uploadedByUserId String?
  createdAt        DateTime @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, category])
  @@map("partnership_documents")
}

// ─────────────────────────────── Finance ────────────────────────────────────

/// Une échéance et son règlement. Purement déclaratif : Kotbo n'encaisse rien
/// pour le compte d'un serveur, il tient le carnet et rappelle les dates.
model PartnershipPayment {
  id            String @id @default(cuid())
  partnershipId String

  direction PartnershipDirection @default(RECEIVED)
  label     String?

  amountCents Int
  currency    String @default("EUR")

  dueAt      DateTime
  status     PartnershipPaymentStatus @default(SCHEDULED)
  settledAt  DateTime?
  /// Moyen déclaré : virement, PayPal, lots, prestation.
  method     String?
  reference  String?
  note       String?

  /// Rappel envoyé, pour ne pas le renvoyer à chaque passage du cron.
  reminderSentAt DateTime?

  recordedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, status])
  @@index([status, dueAt])
  @@map("partnership_payments")
}

// ─────────────────────────────── Entrées ────────────────────────────────────

/// Une candidature reçue : formulaire, ticket, commande ou annuaire.
///
/// Distincte du dossier : la plupart des candidatures n'en deviendront pas un,
/// et les mélanger polluerait le pipeline avec des demandes non instruites.
model PartnerApplication {
  id      String           @id @default(cuid())
  scope   PartnershipScope @default(GUILD)
  guildId String?

  /// Fiche partenaire, créée à l'acceptation. Nulle tant qu'on n'a rien décidé.
  partnerId String?

  /// `form` | `ticket` | `command` | `directory` | `manual`.
  source String @default("form")

  /// Demandeur.
  applicantUserId String?
  applicantTag    String?

  /// Ce qu'il présente. Champs volontairement plats : la candidature doit
  /// rester lisible même si le formulaire qui l'a produite a changé depuis.
  projectName    String
  projectKind    String @default("SERVER")
  projectGuildId String?
  inviteUrl      String?
  memberCount    Int?
  description    String?
  /// Type de partenariat demandé, cf. `PARTNERSHIP_TYPES`.
  requestedType  String?
  /// Réponses au formulaire personnalisé, telles qu'il les a produites.
  answers        Json?

  status PartnerApplicationStatus @default(PENDING)
  /// Motif de refus, communiqué au demandeur.
  decisionReason String?
  decidedByUserId String?
  decidedAt      DateTime?

  /// Ticket ouvert pour instruire la demande.
  ticketId String?
  /// Dossier créé à l'acceptation.
  partnershipId String?

  /// Contrôles automatiques passés à la réception : seuils, liste de blocage,
  /// signaux du réseau. Affichés au staff avant décision.
  screening Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild   Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([guildId, status])
  @@index([applicantUserId])
  @@index([status, createdAt])
  @@map("partner_applications")
}

/// Accès en lecture et en signature donné à un partenaire sans Kotbo.
///
/// Un jeton, une portée, une expiration. Le portail ne montre que le dossier
/// visé et jamais les notes internes : c'est la condition pour qu'un lien
/// transmis de bonne foi ne devienne pas une fuite.
model PartnershipGuestAccess {
  id            String @id @default(cuid())
  partnershipId String

  /// Empreinte du jeton, jamais le jeton lui-même : le lien n'est affiché
  /// qu'une fois, à la création.
  tokenHash String @unique
  /// À qui il a été remis, pour révoquer le bon lien.
  label     String?

  /// `view` | `sign` : consulter, ou consulter et accepter l'accord.
  capability String @default("view")

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  createdByUserId String?
  createdAt       DateTime @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId, revokedAt])
  @@map("partnership_guest_access")
}

// ─────────────────────────────── Annuaire ───────────────────────────────────

/// La vitrine d'un serveur dans l'annuaire inter-serveurs Kotbo.
///
/// Opt-in strict, et n'expose que ce que le serveur a décidé de publier. Les
/// chiffres repris (effectif, activité) sont des tranches, pas des valeurs
/// exactes : l'annuaire sert à trouver un partenaire compatible, pas à
/// constituer un fichier de communautés.
model PartnershipDirectoryListing {
  guildId String @id

  published Boolean @default(false)

  displayName String
  headline    String?
  description String?
  tags        String[] @default([])
  locale      String   @default("fr")
  /// Tranche d'effectif : `<100` | `100-1k` | `1k-10k` | `10k+`.
  sizeBucket  String?
  iconUrl     String?
  bannerUrl   String?
  inviteUrl   String?

  /// Types de partenariat recherchés, cf. `PARTNERSHIP_TYPES`.
  seekingTypes String[] @default([])
  /// Effectif minimal attendu d'un partenaire, pour filtrer les propositions.
  minPartnerSize Int @default(0)
  /// Accepte les propositions spontanées.
  openToProposals Boolean @default(true)

  /// Réputation publique, dérivée des dossiers menés à terme. Jamais saisie.
  reliabilityScore Int @default(50)
  partnershipsDone Int @default(0)

  lastPublishedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([published, locale])
  @@map("partnership_directory_listings")
}

/// Une proposition envoyée d'un serveur à un autre par l'annuaire.
model PartnershipProposal {
  id String @id @default(cuid())

  fromGuildId String
  toGuildId   String

  /// Type proposé et mot d'accompagnement.
  type    String
  message String?

  status PartnershipProposalStatus @default(SENT)

  /// Dossiers créés de part et d'autre à l'acceptation.
  fromPartnershipId String?
  toPartnershipId   String?

  sentByUserId String?
  seenAt       DateTime?
  respondedAt  DateTime?
  responseNote String?
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromGuild Guild @relation("PartnershipProposalsSent", fields: [fromGuildId], references: [id], onDelete: Cascade)
  toGuild   Guild @relation("PartnershipProposalsReceived", fields: [toGuildId], references: [id], onDelete: Cascade)

  @@index([toGuildId, status])
  @@index([fromGuildId, status])
  @@index([status, expiresAt])
  @@map("partnership_proposals")
}

/// Une suggestion de partenaire compatible, calculée par le matchmaking.
///
/// Conservée plutôt que recalculée à l'affichage, pour deux raisons : ne pas
/// re-proposer un serveur que le staff a déjà écarté, et garder la raison du
/// rapprochement, sans laquelle une suggestion n'inspire pas confiance.
model PartnershipMatchSuggestion {
  id String @id @default(cuid())

  guildId          String
  suggestedGuildId String

  /// 0 à 100. Proximité de thèmes, d'effectif, de langue et de fuseau.
  score   Int
  /// Ce qui a produit le rapprochement, en clair : `{ tags: [...], sizeGap: … }`.
  reasons Json?

  /// Écartée par le staff : ne plus la proposer.
  dismissed       Boolean   @default(false)
  dismissedAt     DateTime?
  dismissedByUserId String?
  /// Proposition envoyée à partir de cette suggestion.
  proposalId      String?

  computedAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, suggestedGuildId])
  @@index([guildId, dismissed, score])
  @@map("partnership_match_suggestions")
}

// ─────────────────────────────── Réputation ─────────────────────────────────

/// Un signalement émis par un serveur au sujet d'un partenaire.
///
/// Le module ne refuse jamais un partenariat sur la foi d'un signalement : il
/// l'affiche au staff, qui décide. Un signal automatique serait une arme -
/// deux serveurs en conflit se bloqueraient mutuellement le lendemain.
model PartnerReputationReport {
  id String @id @default(cuid())

  /// Serveur qui signale.
  reporterGuildId String
  partnerId       String
  /// Serveur visé, quand le partenaire en est un. C'est la clé de
  /// rapprochement entre serveurs, la fiche locale n'étant pas partagée.
  subjectGuildId  String?

  /// `unmet_commitment` | `deleted_ad` | `ghosting` | `scam` | `harassment` |
  /// `raid` | `other`.
  reason String
  detail String?
  /// Gravité 1 à 3. Seuls les signalements graves remontent au réseau.
  severity Int @default(1)

  /// Partagé au réseau. Faux tant que le serveur n'a pas activé le partage.
  shared    Boolean @default(false)
  /// Retiré par son auteur : un litige résolu doit pouvoir s'effacer.
  withdrawnAt DateTime?

  reportedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  reporter Guild  @relation(fields: [reporterGuildId], references: [id], onDelete: Cascade)

  @@index([subjectGuildId, shared])
  @@index([reporterGuildId, createdAt])
  @@map("partner_reputation_reports")
}

/// L'agrégat consultable du réseau, par serveur visé.
///
/// Aucun identifiant de serveur signaleur : le staff qui consulte voit
/// combien de signalements, de quelle nature et sur quelle période, jamais
/// par qui. Sans cet anonymat, consulter un signal reviendrait à désigner un
/// accusateur, et personne ne signalerait plus rien.
model PartnerReputationSignal {
  subjectGuildId String @id

  reportCount    Int @default(0)
  reporterCount  Int @default(0)
  /// Somme des gravités, pour pondérer un grand nombre de signaux légers.
  severityScore  Int @default(0)
  /// Répartition par motif : `{ "deleted_ad": 3, "ghosting": 1 }`.
  reasonBreakdown Json?

  firstReportedAt DateTime?
  lastReportedAt  DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([severityScore])
  @@map("partner_reputation_signals")
}

/// Liste de blocage locale : serveurs, personnes ou organisations avec qui ce
/// serveur ne veut plus travailler.
model PartnerBlocklistEntry {
  id      String @id @default(cuid())
  guildId String

  /// `guild` | `user` | `name`. Le dernier bloque par libellé, pour les
  /// organisations qui n'ont pas d'identifiant Discord.
  subjectType String
  subjectRef  String

  reason String?
  /// Bloqué suite à une rupture, avec le dossier d'origine en référence.
  sourcePartnershipId String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, subjectType, subjectRef])
  @@index([guildId])
  @@map("partner_blocklist_entries")
}

/// Mémoire des alertes du module, pour ne pas répéter la même chaque heure.
/// Une alerte qui se répète est une alerte qu'on finit par ignorer.
model PartnershipAlertState {
  /// `renewal:<partnershipId>` | `payment:<paymentId>` | `breach:<commitmentId>`.
  key         String   @id
  lastFiredAt DateTime
  lastValue   Float?

  @@map("partnership_alert_states")
}

model FunGameState {
  guildId            String   @id
  countingCurrent    Int      @default(0)
  countingLastUserId String?
  oneWordStoryLastUserId String?
  guessNumberTarget  Int      @default(0)
  wordChainLastWord    String?
  wordChainLastUserId  String?
  /** Rébus courant, ex. "🦁👑" - résolu contre `emojiRiddleAnswer` (JSON des réponses acceptées). */
  emojiRiddleEmojis    String?
  emojiRiddleAnswer    String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("fun_game_states")
}

model DeveloperExcuse {
  id        String   @id @default(cuid())
  text      String
  language  String   @default("fr")
  category  String?
  createdAt DateTime @default(now())

  @@map("developer_excuses")
  @@index([language])
  @@index([category])
}

model Giveaway {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  prize          String
  description    String?
  winnerCount    Int      @default(1)
  endsAt         DateTime
  ended          Boolean  @default(false)
  /// Auteur du giveaway, affiché sur la page publique. `null` pour les
  /// giveaways créés avant l'ajout de la colonne.
  createdById    String?

  participants   String[] @default([]) // Array of User IDs
  winners        String[] @default([]) // Array of User IDs

  // RPG / Économie additionnels
  rpgXp          Int      @default(0)
  rpgCoins       Int      @default(0)
  rpgItemId      String?
  needValidation Boolean  @default(false)
  validationStatus String @default("APPROVED") // PENDING, APPROVED, REJECTED
  pendingWinners String[] @default([]) // Gagnants potentiels en attente de validation

  /// Surcharges d'apparence propres à ce concours, mêmes clefs que les réglages
  /// du serveur dans `GiveawayConfig`. Permet un concours d'Halloween aux
  /// couleurs différentes sans toucher au réglage de tout le serveur.
  styleOverrides Json?

  /// Tirage strictement égalitaire : ni chances de rôle, ni bonus de clan, même
  /// si le serveur en a configuré. Un concours ouvert à tous sans avantage reste
  /// possible sans devoir désactiver les réglages du serveur.
  ignoreBonuses Boolean @default(false)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La page publique liste les giveaways d'un serveur en séparant ceux en
  // cours de ceux terminés, triés par date de fin.
  @@index([guildId, ended, endsAt])
  @@map("giveaways")
}

/// Réglages des giveaways d'un serveur : qui peut les lancer, qui peut y jouer.
///
/// Sans cette table, seuls « Gérer les messages » côté Discord et les
/// administrateurs du dashboard pouvaient créer un concours : aucun moyen de
/// confier les giveaways à une équipe animation sans lui donner des droits de
/// modération.
model GiveawayConfig {
  guildId String @id

  /// Rôles autorisés à créer, clôturer, relancer et supprimer un giveaway,
  /// en plus des administrateurs et des porteurs de « Gérer les messages ».
  managerRoleIds String[] @default([])

  /// Rôles exigés pour participer. Vide = ouvert à tout le serveur.
  requiredRoleIds String[] @default([])

  /// Rôles exclus de la participation, prioritaires sur `requiredRoleIds`.
  blockedRoleIds String[] @default([])

  /// Ancienneté minimale du compte Discord, en jours. 0 = pas de condition.
  minAccountAgeDays Int @default(0)

  /// Ancienneté minimale sur le serveur, en jours. 0 = pas de condition.
  minMemberAgeDays Int @default(0)

  /// Niveau minimum exigé, lu dans `MemberLevel`. 0 = pas de condition.
  minLevel Int @default(0)

  /// Une personne, une entrée : les comptes liés dans la section Modération ne
  /// participent qu'une fois et ne comptent qu'une fois au tirage. Désactivé par
  /// défaut, c'est un durcissement que chaque serveur décide.
  blockLinkedAccounts Boolean @default(false)

  /// Chances supplémentaires par rôle : `[{ roleId, weight }]`. Le poids le plus
  /// élevé parmi les rôles portés s'applique, les rôles ne se cumulent pas.
  bonusEntries Json @default("[]")

  /// Reprend le bonus de concours accordé au clan vainqueur dans la section
  /// Clans. Décocher le refuse pour les giveaways sans toucher aux Clans.
  clanBonusEnabled Boolean @default(true)

  /// Chances des membres des clans vainqueurs. 2 reprend le doublement que le
  /// tirage appliquait en dur avant que ce bonus soit réglable.
  clanBonusWeight Int @default(2)

  /// Annonce les rôles avantagés dans l'embed : sans cela, un membre perd sans
  /// savoir que d'autres avaient plus de chances que lui.
  showBonusRoles Boolean @default(true)

  /// Salon proposé d'office au lancement. `null` n'en propose aucun : un serveur
  /// qui publie toujours au même endroit le resélectionnait à chaque concours.
  defaultChannelId String?

  /// Couleurs de l'embed selon l'état du concours.
  embedColorActive    String @default("#5865F2")
  embedColorPending   String @default("#FAA81A")
  embedColorEnded     String @default("#ED4245")
  embedColorValidated String @default("#57F287")

  /// Gabarits de l'embed. `null` vaut le texte d'usine, traduit dans la langue
  /// du serveur : les porter en valeur par défaut de colonne les figerait en
  /// français pour tout le monde.
  /// Variables : {prize}, {winnerCount}, {participants}, {winners}, {host},
  /// {id}, {server}, {endsAt}, {endsRelative}.
  titleTemplate       String?
  descriptionTemplate String?
  footerTemplate      String?
  thumbnailUrl        String?
  imageUrl            String?

  /// Bouton de participation. `joinButtonStyle` vaut PRIMARY, SECONDARY,
  /// SUCCESS ou DANGER. Un emoji vide est un choix, pas une absence de réglage.
  joinButtonLabel String?
  joinButtonEmoji String?
  joinButtonStyle String  @default("PRIMARY")

  /// Messages envoyés dans le salon à la clôture.
  announceWinnersTemplate  String?
  announceNoWinnerTemplate String?

  /// Réponses éphémères au clic sur le bouton.
  joinReplyTemplate  String?
  leaveReplyTemplate String?

  /// Refus de participation. Expliquer comment obtenir le rôle vaut mieux qu'un
  /// « non » sec : ces textes sont donc à la main du serveur.
  deniedBlockedTemplate    String?
  deniedRequiredTemplate   String?
  deniedAccountAgeTemplate String?
  deniedMemberAgeTemplate  String?
  deniedLevelTemplate      String?
  deniedLinkedTemplate     String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("giveaway_configs")
}

/// Sauvegarde nommée des réglages giveaway d'un serveur.
///
/// L'onglet Configuration n'écrivait que `GiveawayConfig`, unique par serveur :
/// repasser sur une apparence de fin d'année après l'avoir remplacée imposait
/// de ressaisir couleurs, gabarits et conditions de mémoire. Une sauvegarde fige
/// l'état d'un instant et se réapplique d'un clic.
model GiveawayConfigPreset {
  id      String @id @default(cuid())
  guildId String

  name String

  /// Réglages figés, mêmes clefs que les colonnes de `GiveawayConfig`. Un blob
  /// plutôt que trente-cinq colonnes dupliquées : une sauvegarde ne se filtre ni
  /// ne se trie sur son contenu, et suivre chaque ajout de réglage dans deux
  /// tables les aurait fait diverger. La relecture repasse par la validation de
  /// l'API, une sauvegarde ancienne ne peut donc pas écrire n'importe quoi.
  settings Json

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@map("giveaway_config_presets")
}

/// Modèle de concours réutilisable : lot, duree, récompenses et apparence déjà
/// remplis. Un serveur qui relance le même concours chaque semaine n'a plus à
/// ressaisir dix champs à chaque fois.
model GiveawayTemplate {
  id      String @id @default(cuid())
  guildId String

  name String

  prize           String
  description     String?
  winnerCount     Int     @default(1)
  durationMinutes Int     @default(1440)
  channelId       String?

  rpgXp          Int     @default(0)
  rpgCoins       Int     @default(0)
  rpgItemId      String?
  needValidation Boolean @default(false)

  /// Voir `Giveaway.ignoreBonuses`.
  ignoreBonuses Boolean @default(false)

  /// Mêmes clefs que `Giveaway.styleOverrides` : apparence propre au modèle.
  styleOverrides Json?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@map("giveaway_templates")
}


model Suggestion {
  id             String   @id @default(cuid())
  guildId        String
  userId         String
  username       String
  content        String
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, IMPLEMENTED
  channelId      String?
  messageId      String?
  responseText   String?
  respondedById  String?
  respondedAt    DateTime?

  upvoters       String[] @default([]) // Array of User IDs
  downvoters     String[] @default([]) // Array of User IDs

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suggestions")
}

model ReactionRoleMenu {
  id         String  @id @default(cuid())
  guildId    String
  channelId  String
  messageId  String?
  title      String
  options    Json    // List of { emoji?: string, label: string, roleId: string, mode?: "toggle" | "add_only" }
  buttonMode String  @default("toggle") // "toggle" | "add_only", surchargeable option par option

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  @@map("reaction_role_menus")
}

model EconomyConfig {
  guildId           String   @id
  enabled           Boolean  @default(false)
  rpgEnabled        Boolean  @default(false)
  guildsEnabled     Boolean  @default(false)
  shopEnabled       Boolean  @default(false)
  
  currencyName      String   @default("KotboCoins")
  currencyEmoji     String   @default("🪙")
  currencyIcon      String?
  dailyRewardMin    Int      @default(50)
  dailyRewardMax    Int      @default(150)
  dailyCooldownHour Int      @default(20) // Heures de recharge du /daily
  
  adventureCooldownMin Int   @default(30)  // Temps entre chaque aventure (en minutes)
  maxEnergy            Int   @default(100)
  energyRecoveryPerHour Int  @default(10)

  // Délais entre deux combats. Le boss a le sien, distinct de son `bossRespawnHours` :
  // celui-ci empêche de refaire le même boss, `bossCooldownMin` d'enchaîner deux boss
  // différents. 0 = enchaînement libre.
  fightCooldownSec     Int   @default(120)
  bossCooldownMin      Int   @default(2)

  // Annonce du premier joueur à vaincre une créature : NONE, BOSSES (boss seulement,
  // pour ne pas inonder le salon des dizaines de monstres ordinaires) ou ALL.
  firstKillAnnounce    String  @default("NONE")
  firstKillChannelId   String?

  // Garde-fous anti-abus (gambling / transferts)
  maxBetAmount         Int   @default(1000) // Mise maximale autorisée pour dice/roulette/rps
  maxDailyBets         Int   @default(20)   // Nombre maximal de parties de jeux d'argent par jour et par membre
  maxTransferAmount    Int   @default(5000) // Montant maximal transférable en une fois via /rpg-pay
  transferCooldownMin  Int   @default(15)   // Temps minimum entre deux transferts (en minutes)

  // Taxe de l'hôtel des ventes : part du prix de vente retenue sur ce que touche le vendeur.
  // Les pièces retenues disparaissent, ce qui freine l'inflation de la monnaie.
  marketplaceTaxPercent Int  @default(5)

  // ── Marché noir ─────────────────────────────────────────────────────────
  // Une fenêtre d'ouverture courte, à heure imprévisible, où chaque membre se voit
  // proposer sa propre sélection d'objets de la boutique à prix cassé.
  blackMarketEnabled      Boolean @default(false)
  blackMarketIntervalDays Int     @default(7)   // Périodicité moyenne entre deux ouvertures
  blackMarketDurationMin  Int     @default(120) // Durée de la fenêtre d'ouverture, en minutes
  blackMarketOfferCount   Int     @default(4)   // Nombre d'offres tirées par membre
  blackMarketMaxQuantity  Int     @default(3)   // Achats maximum par offre
  blackMarketDiscountMin  Int     @default(20)  // Remise minimale appliquée, en pourcentage
  blackMarketDiscountMax  Int     @default(50)  // Remise maximale appliquée, en pourcentage
  // Annonce : NONE = découverte passive via le hub /rpg, CHANNEL = message public,
  // CHANNEL_ROLE = message public avec mention du rôle `blackMarketRoleId`.
  blackMarketAnnounce     String  @default("NONE")
  blackMarketChannelId    String?
  blackMarketRoleId       String?

  // ── Difficulté du bestiaire ─────────────────────────────────────────────
  // Dernier préréglage appliqué aux créatures du serveur (EASY, NORMAL, HARD).
  // Il ne modifie rien au jeu : les statistiques sont réécrites sur les fiches au
  // moment du clic. La valeur n'est gardée que pour savoir de quel palier partir
  // au préréglage suivant, sans quoi deux clics se multiplieraient entre eux.
  // Les boss et les monstres ordinaires se règlent séparément.
  // Les prix de la boutique ont leur propre palier, appliqué aux seuls objets créés par
  // le serveur : le catalogue livré n'a pas de copie locale, un objet étant désigné par son
  // identifiant dans les inventaires, les recettes et les offres du marché noir.
  bossDifficulty    String @default("NORMAL")
  monsterDifficulty String @default("NORMAL")
  shopDifficulty    String @default("NORMAL")

  // ── Raid hebdomadaire ───────────────────────────────────────────────────
  // Chaque équipe affronte sa propre instance du boss, dont la réserve de points de
  // vie suit son effectif : une instance partagée par tout le serveur laisserait les
  // petites équipes sans rien à frapper.
  raidEnabled            Boolean @default(false)
  /// Ouverture automatique au jour et a l'heure reglés. A faux, le raid n'ouvre que
  /// sur un lancement manuel depuis le dashboard.
  raidAutoSchedule       Boolean @default(true)
  // CLAN = les clans du serveur, par rôle Discord. RPG_GUILD = les guildes du jeu.
  raidTeamMode           String  @default("CLAN")
  /// Nom du boss de raid à ouvrir. Nul = tirage au sort parmi les boss actifs.
  raidBossName           String?
  // Ces trois valeurs ont été ramenées d'un facteur 0,766 lorsque la formule de dégâts
  // est passée à une atténuation par ratio : à réserve inchangée, le même raid aurait
  // demandé un tiers de coups en plus.
  raidHealthPerMember    Int     @default(920) // Réserve ajoutée par membre de l'équipe
  raidHealthFloor        Int     @default(1915) // Réserve minimale, pour une équipe minuscule
  raidHealthCap          Int     @default(46000) // Réserve maximale, pour une équipe nombreuse
  raidAssaultsPerMember  Int     @default(3)
  /// Assauts supplémentaires qu'un membre peut s'offrir par raid, potions comprises.
  /// Sans plafond, un joueur fortuné abattrait le boss seul et l'enveloppe proportionnelle
  /// à l'effectif ne voudrait plus rien dire.
  raidBoughtAssaultsMax  Int     @default(3)
  /// Part de l'enveloppe versée à une équipe qui n'abat pas son boss, en pourcentage.
  /// Zéro ne récompense que la victoire. Trois heures d'assauts pour rien ne ramènent
  /// personne la semaine suivante, mais l'échec ne doit pas payer autant que la victoire.
  raidConsolationShare   Int     @default(25)
  raidEnergyCost         Int     @default(25)
  raidWeekday            Int     @default(6)  // 0 = dimanche, 6 = samedi
  raidHour               Int     @default(20) // Heure d'ouverture, sur le fuseau du serveur
  raidDurationHours      Int     @default(24)
  /// Récompenses réglées **par membre** : l'enveloppe d'une équipe suit son effectif, comme
  /// sa réserve de points de vie, puis se partage entre les participants au prorata des
  /// dégâts. Fixe, elle faisait de l'équipe d'une personne la seule façon rationnelle de jouer.
  raidXpReward           Int     @default(60)
  raidCoinReward         Int     @default(45)
  raidClanPoints         Int     @default(6)
  raidAnnounce           String  @default("CHANNEL")
  raidChannelId          String?
  raidRoleId             String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("economy_configs")
}

/// Fenêtre d'ouverture du marché noir, commune à tout le serveur. Les offres, elles,
/// sont tirées par membre (voir `RpgBlackMarketOffer`) : deux joueurs ne voient jamais
/// la même vitrine, ce qui évite la course au meilleur prix entre membres connectés.
model RpgBlackMarketSession {
  id          String    @id @default(cuid())
  guildId     String
  opensAt     DateTime
  closesAt    DateTime
  /// Renseigné une fois l'annonce publiée, pour ne jamais annoncer deux fois la même session.
  announcedAt DateTime?
  createdAt   DateTime  @default(now())

  offers RpgBlackMarketOffer[]
  guild  Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, opensAt])
  @@index([guildId, closesAt])
  @@map("rpg_black_market_sessions")
}

/// Offre personnelle d'un membre pour une session donnée. Le prix remisé est figé au
/// tirage : une modification du prix boutique en cours de session ne peut pas rétroactivement
/// renchérir ni brader ce qui a été proposé au joueur.
model RpgBlackMarketOffer {
  id        String @id @default(cuid())
  sessionId String
  userId    String
  itemId    String
  price     Int
  discount  Int
  stock     Int    @default(1)
  purchased Int    @default(0)

  createdAt DateTime @default(now())

  session RpgBlackMarketSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    RpgItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, itemId])
  @@index([sessionId, userId])
  @@map("rpg_black_market_offers")
}

model RpgProfile {
  id        String   @id @default(cuid())
  guildId   String
  userId    String

  // Économie de base
  balance   Int      @default(0)
  lastDaily DateTime?
  // Jours de /daily réclamés d'affilée : chaque jour de série majore la récompense.
  dailyStreak Int @default(0)
  lastWork  DateTime?

  // Statistiques RPG.
  // IMPORTANT : `attack`/`defense`/`speed`/`maxHealth` sont les stats de BASE du personnage
  // (niveaux + points investis). Les bonus d'équipement, d'amélioration et de classe sont
  // calculés à la lecture par `getEffectiveStats` et ne sont JAMAIS écrits ici.
  level     Int      @default(1)
  xp        Int      @default(0)
  health    Int      @default(100)
  maxHealth Int      @default(100)
  energy    Int      @default(100)
  attack    Int      @default(10)
  defense   Int      @default(10)
  speed     Int      @default(10)

  // Classe (WARRIOR | RANGER | MAGE), choisie à partir du niveau 5.
  className   String?
  // Points de caractéristiques gagnés à chaque niveau et non encore répartis.
  statPoints  Int      @default(0)
  // Points d'arbre de compétences, distincts des points de caractéristiques : les
  // premiers achètent des nœuds, les seconds montent les stats de base. Les mélanger
  // ferait d'un arbre à embranchements un simple second curseur de statistiques.
  skillPoints Int      @default(0)

  // Équipement équipé.
  // Les trois emplacements d'accessoire se débloquent au niveau (`ACCESSORY_SLOT_LEVELS`) :
  // `accessoryId` reste le premier, pour que les profils d'avant la migration gardent
  // l'accessoire qu'ils portaient sans aucune reprise de données.
  weaponId  String?
  armorId   String?
  accessoryId String?
  accessory2Id String?
  accessory3Id String?
  potionId  String?

  // Le niveau de forge et les enchantements ne vivent PLUS ici : ils appartiennent à
  // l'instance d'objet (`RpgItemInstance`), donc à l'objet possédé et non à l'emplacement.
  // Déséquiper puis rééquiper une arme conserve son +7 et ses enchantements, et améliorer
  // une babiole n'avantage plus l'arme légendaire qu'on glisse ensuite dans le même slot.

  // Combat & Pêche
  totalMonstersKilled Int      @default(0)
  totalBossesKilled   Int      @default(0)
  totalFishCaught     Int      @default(0)
  lastFish            DateTime?
  lastBattle          DateTime?
  lastBossBattle      DateTime?

  // Objets mis en favori, remontés en tête du sac et du menu des potions. Portés par le
  // profil et non par la ligne d'inventaire : celle-ci disparaît avec le dernier
  // exemplaire, et la potion rachetée perdrait son étoile.
  favoriteItemIds     String[] @default([])
  firstKills          RpgMonsterFirstKill[]

  // Titre porté : affiché en haut de la carte, et seul titre dont les bonus comptent.
  // En posséder plusieurs ne les cumule pas, sans quoi collectionner les titres
  // deviendrait le moyen le plus sûr de monter ses statistiques.
  activeTitleId       String?
  activeTitle         RpgTitle? @relation("ActiveTitle", fields: [activeTitleId], references: [id], onDelete: SetNull)
  titles              RpgProfileTitle[]

  // État de voyage
  isTraveling    Boolean   @default(false)
  travelDestination String?
  travelDurationMin  Int      @default(0)
  travelStartedAt DateTime?
  lastEventAt     DateTime?
  lastTravelEndedAt DateTime? // Fin du dernier voyage résolu, sert de base au cooldown d'aventure

  // Régénération d'énergie : horodatage dédié, distinct de `updatedAt`, pour que
  // les actions qui ne touchent pas l'énergie (pay, gambling, etc.) ne remettent
  // pas à zéro la fenêtre de calcul de la régénération.
  lastEnergyTick DateTime? @default(now())

  // Anti-abus jeux d'argent (dice/roulette/rps) : fenêtre glissante de 24h
  dailyBetCount       Int       @default(0)
  dailyBetWindowStart DateTime?

  // Anti-abus transferts (/rpg-pay)
  lastTransferAt DateTime?

  // Relations
  rpgGuildId String?
  rpgGuild   RpgGuild? @relation(fields: [rpgGuildId], references: [id], onDelete: SetNull)
  inventory  RpgInventoryItem[]
  itemInstances RpgItemInstance[]
  skillUnlocks RpgSkillUnlock[]
  battles    RpgBattle[]
  fishCatches RpgFishCatch[]
  fishBookClaims RpgFishBookClaim[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, balance])
  @@index([guildId, level, xp])
  @@map("rpg_profiles")
}

/**
 * Nœud d'arbre de compétences acheté par un joueur.
 *
 * L'arbre lui-même est du contenu statique (`rpgSkillTree.ts`) : seule la progression
 * vit en base. `nodeId` référence donc le catalogue, sans clé étrangère - un nœud retiré
 * du catalogue laisse une ligne inerte, que la lecture ignore, plutôt qu'une contrainte
 * qui ferait échouer la migration de tout un serveur.
 */
model RpgSkillUnlock {
  id           String @id @default(cuid())
  rpgProfileId String
  nodeId       String
  /// Rang atteint sur ce nœud, de 1 à `maxRank`. Les nœuds à rang unique valent 1.
  rank         Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile RpgProfile @relation(fields: [rpgProfileId], references: [id], onDelete: Cascade)

  @@unique([rpgProfileId, nodeId])
  @@index([rpgProfileId])
  @@map("rpg_skill_unlocks")
}

model RpgItem {
  id          String   @id @default(cuid())
  guildId     String?  // null = global (item par défaut du bot)
  name        String
  description String
  emoji       String   @default("📦")
  /// Famille de l'objet. Liste de reference : RPG_ITEM_TYPES dans @kotbo/contracts.
  /// WEAPON | ARMOR | ACCESSORY | POTION | MATERIAL | SCROLL | QUEST
  type        String

  // Statistiques d'équipement/utilisation
  atkBonus    Int      @default(0)
  defBonus    Int      @default(0)
  spdBonus    Int      @default(0)
  hpBonus     Int      @default(0)  // PV maximum accordés par l'objet (accessoires surtout)
  hpRestore   Int      @default(0)
  energyRestore Int    @default(0)
  /// Assauts de raid rendus à la consommation, en plus du quota de la semaine. La potion
  /// ne se boit que pendant une fenêtre ouverte : le bonus vaut pour ce raid et meurt avec.
  raidAssaultBonus Int @default(0)

  /// Parchemin d'enchantement : identifiant du catalogue `rpgEnchantments.ts` posé par
  /// cet objet, et palier accordé. Renseignés uniquement pour `type = "SCROLL"`.
  enchantId   String?
  enchantTier Int      @default(1)

  // Rareté et niveau requis
  rarity        String   @default("COMMON") // COMMON | UNCOMMON | RARE | EPIC | LEGENDARY
  levelRequired Int      @default(0)

  // Récompenses versées par les modules voisins à la consommation. Un objet qui en
  // porte disparaît de la boutique tant que le module correspondant est éteint : sans
  // ça, la boutique vendrait de l'XP à un serveur qui n'a pas de niveaux.
  levelXpReward    Int @default(0)
  clanPointsReward Int @default(0)

  // Prix d'achat en boutique
  price       Int      @default(0)
  purchasable Boolean  @default(true)
  /// Autorise le tirage de cet objet au marché noir. Les objets qui vendent une
  /// récompense de module en sortent par défaut : leur prix est un prix, pas une
  /// base de négociation à -50 %.
  blackMarketEligible Boolean @default(true)
  /// Autorise le démantèlement de l'objet contre une partie des matériaux de sa recette.
  /// Sans recette, l'objet ne se démantèle de toute façon pas.
  salvageable Boolean @default(true)

  inventoryEntries  RpgInventoryItem[]
  instances         RpgItemInstance[]
  recipes           RpgRecipe[]
  blackMarketOffers RpgBlackMarketOffer[]
  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId, type])
  @@map("rpg_items")
}

/// Recette d'artisanat : transforme des matériaux (drops de monstres, poissons…) en
/// équipement. C'est ce qui donne une utilité aux butins ramassés en combat.
model RpgRecipe {
  id           String  @id @default(cuid())
  guildId      String? // null = recette globale fournie de base
  resultItemId String
  /// [{ itemName: string, quantity: number }]
  ingredients  Json
  coinCost     Int     @default(0)
  levelRequired Int    @default(1)

  resultItem RpgItem @relation(fields: [resultItemId], references: [id], onDelete: Cascade)
  guild      Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("rpg_recipes")
}

model RpgInventoryItem {
  id           String   @id @default(cuid())
  rpgProfileId String
  itemId       String
  quantity     Int      @default(1)

  profile RpgProfile @relation(fields: [rpgProfileId], references: [id], onDelete: Cascade)
  item    RpgItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([rpgProfileId, itemId])
  @@map("rpg_inventory_items")
}

/// Exemplaire individualisé d'un objet possédé : un exemplaire forgé ou enchanté, distinct
/// des exemplaires ordinaires de la même pile.
///
/// `RpgInventoryItem.quantity` compte TOUS les exemplaires ; chaque ligne d'ici en désigne
/// un seul, et il y en a au plus autant que la quantité. Les exemplaires ordinaires sont la
/// différence. Une épée forgée à +2 ne rend donc plus +2 les épées ramassées ensuite.
///
/// Un exemplaire revenu à +0 sans enchantement est supprimé : il redevient ordinaire et
/// rejoint la pile. `equipped` désigne l'exemplaire porté quand l'objet occupe un
/// emplacement ; sans exemplaire marqué, c'est un exemplaire ordinaire qui est porté.
model RpgItemInstance {
  id           String   @id @default(cuid())
  rpgProfileId String
  itemId       String

  /// Niveau d'amélioration (forge), de 0 à 10.
  upgrade  Int  @default(0)
  /// Enchantements posés : [{ id: string, tier: number }]. Validé par `parseEnchants`.
  enchants Json @default("[]")
  /// Exemplaire porté. Au plus un par (profil, objet), un objet n'occupant qu'un emplacement.
  equipped Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile RpgProfile @relation(fields: [rpgProfileId], references: [id], onDelete: Cascade)
  item    RpgItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([rpgProfileId, itemId])
  @@map("rpg_item_instances")
}

model RpgGuild {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  description String?
  emoji     String   @default("🛡️")
  ownerId   String   // Discord UserId du créateur
  
  level     Int      @default(1)
  xp        Int      @default(0)
  treasury  Int      @default(0)

  members   RpgProfile[]
  buildings RpgGuildBuilding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@map("rpg_guilds")
}

/**
 * Batiment du village d'une guilde.
 *
 * Le catalogue est statique (`rpgGuildBuildings.ts`) : seul le niveau atteint vit en
 * base. `buildingId` refere donc le catalogue sans cle etrangere - un batiment retire
 * d'une version a l'autre laisse une ligne inerte, que la lecture ignore, plutot qu'une
 * contrainte qui ferait echouer la migration de tout un serveur.
 */
model RpgGuildBuilding {
  id         String @id @default(cuid())
  rpgGuildId String
  buildingId String
  /// Niveau construit, de 1 a `maxLevel`. Une ligne absente vaut « pas encore batie ».
  level      Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rpgGuild RpgGuild @relation(fields: [rpgGuildId], references: [id], onDelete: Cascade)

  @@unique([rpgGuildId, buildingId])
  @@index([rpgGuildId])
  @@map("rpg_guild_buildings")
}

model RpgAdventureEvent {
  id          String   @id @default(cuid())
  guildId     String?  // null = global (évènements fournis de base)
  title       String
  description String   // Le texte de l'événement (ex: "Vous croisez un marchand suspect...")
  emoji       String   @default("🌲")

  // Choix possibles sous forme de JSON pour flexibilité (options, requis, effets)
  // Format : Array<{ text: string, hpEffect: number, coinEffect: number, xpEffect: number, minLevel: number }>
  choices     Json

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("rpg_adventure_events")
}

model RpgDrop {
  id        String   @id @default(cuid())
  guildId   String
  amount    Int
  type      String   // COINS | XP | ITEM
  itemId    String?  // Si type = ITEM
  claimed   Boolean  @default(false)
  claimedBy String?
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("rpg_drops")
}

// ============================================================================
// MONSTRES & COMBAT
// ============================================================================

model RpgMonster {
  id          String   @id @default(cuid())
  guildId     String?  // null = global (monstres par défaut)
  name        String
  description String
  emoji       String   @default("👹")

  level       Int      @default(1)
  health      Int      @default(50)
  attack      Int      @default(8)
  defense     Int      @default(5)
  speed       Int      @default(5)

  xpReward    Int      @default(20)
  coinReward  Int      @default(10)

  // Drops possibles : [{ itemName, emoji, chance (0-1), coinBonus? }]
  drops       Json     @default("[]")

  isBoss           Boolean @default(false)
  bossRespawnHours Int?

  /// Points de clan versés au vainqueur, quand le pont RPG vers les clans est
  /// ouvert (`Guild.clanPointsFromRpg`). À zéro, la créature ne rapporte rien
  /// au classement des clans.
  clanPoints Int @default(0)

  /// Prime versée au premier joueur du serveur qui abat la créature, en plus du butin
  /// ordinaire. `firstKillItemName` désigne l'objet par son nom, comme les butins ;
  /// `firstKillClanPoints` va au clan, ou à la guilde du jeu, comme `clanPoints`.
  firstKillCoinReward Int     @default(0)
  firstKillXpReward   Int     @default(0)
  firstKillItemName   String?
  firstKillClanPoints Int     @default(0)
  /// Rôle Discord offert au premier vainqueur. Propre au serveur : il ne voyage pas dans
  /// l'export du bestiaire.
  firstKillRoleId     String?
  /// Titre offert au premier vainqueur, et titre gagné par tout joueur qui abat la
  /// créature. Titres du serveur uniquement : un monstre livré de base en reçoit un
  /// via sa copie locale, comme pour toute autre personnalisation.
  firstKillTitleId    String?
  firstKillTitle      RpgTitle? @relation("FirstKillTitle", fields: [firstKillTitleId], references: [id], onDelete: SetNull)
  winTitleId          String?
  winTitle            RpgTitle? @relation("WinTitle", fields: [winTitleId], references: [id], onDelete: SetNull)

  /// Un monstre global désactivé par un serveur est remplacé par une copie locale
  /// portant le même nom avec `enabled = false` : le catalogue global reste intact.
  enabled Boolean @default(true)

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  battles RpgBattle[]

  @@unique([guildId, name])
  @@map("rpg_monsters")
}

/// Titre du RPG, propre à un serveur.
///
/// Un titre s'affiche en haut de la carte du personnage et peut accorder des statistiques.
/// Seul le titre porté compte (`RpgProfile.activeTitleId`) : les autres restent dans la
/// collection du joueur, prêts à être portés.
model RpgTitle {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String   @default("")
  /// Couleur d'affichage sur la carte, en hexadécimal.
  color       String   @default("#fbbf24")

  attackBonus  Int @default(0)
  defenseBonus Int @default(0)
  speedBonus   Int @default(0)
  healthBonus  Int @default(0)
  /// Chance de coup critique ajoutée, en points de pourcentage.
  critBonus    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild             Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  owners            RpgProfileTitle[]
  wearers           RpgProfile[]      @relation("ActiveTitle")
  firstKillMonsters RpgMonster[]      @relation("FirstKillTitle")
  winMonsters       RpgMonster[]      @relation("WinTitle")
  fishBookRewards   RpgFishBookReward[]

  @@unique([guildId, name])
  @@map("rpg_titles")
}

/// Titre possédé par un joueur.
model RpgProfileTitle {
  id         String   @id @default(cuid())
  profileId  String
  titleId    String
  obtainedAt DateTime @default(now())

  profile RpgProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title   RpgTitle   @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([profileId, titleId])
  @@map("rpg_profile_titles")
}

/// Premier joueur du serveur à avoir abattu une créature.
///
/// La créature est désignée par son nom, pas par son identifiant : personnaliser un monstre
/// livré de base en crée une copie locale d'un autre identifiant, et le record ne doit pas
/// repartir de zéro pour autant. L'unicité (serveur, nom) arbitre deux victoires simultanées.
model RpgMonsterFirstKill {
  id          String   @id @default(cuid())
  guildId     String
  monsterName String
  userId      String
  createdAt   DateTime @default(now())

  profile RpgProfile @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@unique([guildId, monsterName])
  @@map("rpg_monster_first_kills")
}

/**
 * Boss de raid propres à un serveur.
 *
 * Contrairement au bestiaire, il n'y a pas de catalogue global masqué par des copies :
 * les fiches livrées de base sont recopiées dans le serveur au premier allumage du raid,
 * puis lui appartiennent. Un raid est un événement rare et très visible, que chaque
 * serveur veut écrire à sa main ; le masquage par nom coûterait sa complexité pour un
 * bénéfice que personne ne demande ici.
 */
/// Objectifs qu'une quête RPG peut poser. Ils se comptent tous sur des actions du jeu :
/// les quêtes de discussion (messages, vocal, réactions) vivent dans leur propre module.
enum RpgQuestObjective {
  MONSTER_KILLS
  BOSS_KILLS
  RAID_ASSAULTS
  RAID_DAMAGE
  ITEMS_LOOTED
  FISH_CAUGHT
  ITEMS_CRAFTED
  UPGRADES_SUCCEEDED
  SHOP_PURCHASES
  BLACK_MARKET_PURCHASES
  COINS_SPENT
  ADVENTURES_COMPLETED
  DAILY_CLAIMS
}

/// MEMBER : chacun sa progression. TEAM : toute une équipe pousse le même compteur.
enum RpgQuestScope {
  MEMBER
  TEAM
}

/**
 * Quête RPG d'un serveur.
 *
 * La fenêtre est une durée libre en heures, alignée sur l'époque : deux équipes courent
 * ainsi la même horloge, sans quoi leurs résultats ne seraient pas comparables. Vingt-quatre
 * heures tombent sur minuit UTC, six heures sur 00, 06, 12 et 18.
 */
model RpgQuest {
  id      String @id @default(cuid())
  guildId String

  name        String
  description String
  emoji       String @default("📜")

  objective RpgQuestObjective
  target    Int               @default(10)

  scope RpgQuestScope @default(MEMBER)
  /// Portée TEAM uniquement : CLAN pour les clans du serveur, RPG_GUILD pour les guildes du jeu.
  teamMode String @default("CLAN")

  /// Portée MEMBER uniquement : une quête répétable repart à zéro dès qu'elle est payée et
  /// peut l'être plusieurs fois dans la journée. Sinon elle ne paie qu'une fois par 24 h.
  repeatable Boolean @default(false)

  windowHours Int @default(24)

  rewardCoins      Int @default(0)
  rewardXp         Int @default(0)
  /// Portée TEAM et clans allumés uniquement : versés au clan de chaque participant.
  rewardClanPoints Int @default(0)

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild    Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  progress RpgQuestProgress[]
  teams    RpgQuestTeamProgress[]

  @@unique([guildId, name])
  @@index([guildId, enabled])
  @@map("rpg_quests")
}

/**
 * Avancement d'un membre.
 *
 * Sur une quête d'équipe, cette ligne porte sa contribution et jamais une récompense : c'est
 * elle qui rend le partage au prorata calculable et vérifiable, comme les assauts le font
 * pour un raid.
 */
model RpgQuestProgress {
  id      String @id @default(cuid())
  guildId String
  questId String
  userId  String

  /// Numéro de fenêtre depuis l'époque, `floor(maintenant / duree)`.
  windowKey String

  /// Équipe pour laquelle la contribution a été faite, chaîne vide sur une quête personnelle.
  ///
  /// Elle fait partie de la clé : un membre qui change de clan en cours de fenêtre ouvre une
  /// nouvelle ligne, et ce qu'il avait apporté reste acquis à son ancienne équipe. Une
  /// colonne facultative n'aurait pas pu servir de clé, Postgres tenant deux NULL pour
  /// distincts.
  teamKey String @default("")

  current Int    @default(0)
  target  Int
  status  String @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | CLAIMED

  /// Nombre de fois que la quête a été payée sur la fenêtre : une quête répétable repart à
  /// zéro à chaque versement, et son compteur seul ne dirait plus rien de ce qu'elle a rendu.
  completions Int @default(0)

  completedAt DateTime?
  claimedAt   DateTime?

  updatedAt DateTime @updatedAt

  guild Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  quest RpgQuest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([questId, userId, windowKey, teamKey])
  @@index([guildId, userId, windowKey])
  @@index([questId, windowKey, teamKey])
  /// Le verrou de 24 h cherche le dernier versement d'un joueur sur une quête, toutes
  /// fenêtres confondues : sans cet index, il balaierait la table à chaque action de jeu.
  @@index([questId, userId, claimedAt])
  @@map("rpg_quest_progress")
}

/// Avancement collectif d'une équipe sur une quête de portée TEAM.
model RpgQuestTeamProgress {
  id      String @id @default(cuid())
  guildId String
  questId String

  teamKey  String
  teamName String

  windowKey String

  current Int @default(0)
  target  Int

  completedAt DateTime?
  /// Posé avant le versement : une équipe n'est jamais payée deux fois.
  rewardedAt  DateTime?

  updatedAt DateTime @updatedAt

  guild Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  quest RpgQuest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([questId, teamKey, windowKey])
  @@index([guildId, windowKey])
  @@map("rpg_quest_team_progress")
}

model RpgRaidBoss {
  id          String  @id @default(cuid())
  guildId     String
  name        String
  description String
  emoji       String  @default("🐲")

  level   Int @default(20)
  attack  Int @default(60)
  defense Int @default(35)
  speed   Int @default(20)

  /// Sorts du boss : [{ id, name, emoji, cooldownTurns, effect: { ... } }].
  /// Lus par le moteur de combat, qui ne connaît aucun sort en particulier.
  spells Json @default("[]")

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  raids RpgRaid[]

  @@unique([guildId, name])
  @@map("rpg_raid_bosses")
}

/// Un raid par serveur et par semaine. Les caractéristiques du boss y sont recopiées à
/// l'ouverture : modifier la fiche ou appliquer un palier de difficulté en pleine fenêtre
/// changerait l'épreuve en cours de route, et les équipes qui ont frappé en premier
/// n'auraient pas couru la même course que les suivantes.
model RpgRaid {
  id      String @id @default(cuid())
  guildId String
  bossId  String?

  status   String @default("SCHEDULED") // SCHEDULED | OPEN | RESOLVED
  teamMode String @default("CLAN")

  bossName    String
  bossEmoji   String
  bossLevel   Int
  bossAttack  Int
  bossDefense Int
  bossSpeed   Int
  bossSpells  Json   @default("[]")

  healthPerMember Int
  healthFloor     Int
  healthCap       Int
  assaultsPerMember Int
  /// Plafond d'assauts achetables par membre, figé à l'ouverture comme le reste : une
  /// potion bue en pleine fenêtre doit valoir ce que le serveur annonçait au départ.
  boughtAssaultsMax Int @default(3)
  /// Figée à l'ouverture comme le reste : une équipe qui a frappé toute la nuit doit
  /// toucher ce que le serveur annonçait, pas ce qu'il a réglé depuis.
  consolationShare  Int @default(25)
  energyCost        Int

  xpReward    Int
  coinReward  Int
  clanPoints  Int

  opensAt    DateTime
  closesAt   DateTime
  announcedAt DateTime?
  resolvedAt  DateTime?

  announceChannelId String?
  announceMessageId String?

  createdAt DateTime @default(now())

  guild Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  boss  RpgRaidBoss?  @relation(fields: [bossId], references: [id], onDelete: SetNull)
  teams RpgRaidTeam[]
  bonuses RpgRaidBonus[]

  @@index([guildId, opensAt])
  @@index([guildId, status])
  @@map("rpg_raids")
}

/// Instance du boss pour une équipe. `teamKey` est l'identifiant du clan ou de la guilde
/// RPG selon le mode ; le nom et l'effectif sont recopiés à l'engagement, un clan renommé
/// ou vidé en cours de route ne devant pas réécrire l'histoire du raid.
model RpgRaidTeam {
  id     String @id @default(cuid())
  raidId String

  teamKey     String
  teamName    String
  memberCount Int

  totalHealth     Int
  remainingHealth Int
  defeatedAt      DateTime?
  rewardedAt      DateTime?

  raid     RpgRaid          @relation(fields: [raidId], references: [id], onDelete: Cascade)
  assaults RpgRaidAssault[]

  @@unique([raidId, teamKey])
  @@map("rpg_raid_teams")
}

/// Un assaut livré par un membre. C'est ce qui porte le partage des récompenses : sans le
/// détail des dégâts, le prorata ne serait ni calculable ni vérifiable.
/// Assauts achetés par un membre sur un raid donné, cumulés.
///
/// La ligne vit et meurt avec le raid : un bonus n'a de sens que dans la fenêtre où il a
/// été bu, et le garder d'une semaine sur l'autre laisserait arriver au raid suivant avec
/// une avance que personne n'aurait vu venir.
model RpgRaidBonus {
  id     String @id @default(cuid())
  raidId String
  userId String

  extraAssaults Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raid RpgRaid @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@unique([raidId, userId])
  @@map("rpg_raid_bonuses")
}

model RpgRaidAssault {
  id         String @id @default(cuid())
  raidTeamId String
  guildId    String
  userId     String

  damage      Int     @default(0)
  killingBlow Boolean @default(false)
  survived    Boolean @default(true)

  createdAt DateTime @default(now())

  team RpgRaidTeam @relation(fields: [raidTeamId], references: [id], onDelete: Cascade)

  @@index([raidTeamId, userId])
  /// Le palmarès du serveur agrège les assauts par membre, sans passer par le raid.
  @@index([guildId, userId])
  @@map("rpg_raid_assaults")
}

/**
 * Classement d'arene d'un joueur.
 *
 * Table a part plutot que des colonnes sur `RpgProfile` : le classement se lit et
 * s'ecrit sur des chemins qui n'ont rien a voir avec le reste du profil, et la table
 * porte son propre index de classement sans alourdir toutes les lectures de profil.
 */
model RpgArenaRecord {
  id      String @id @default(cuid())
  guildId String
  userId  String

  /// Points de classement. Tout le monde part de `ARENA_START_RATING`.
  rating     Int @default(1000)
  bestRating Int @default(1000)
  wins       Int @default(0)
  losses     Int @default(0)
  /// Serie en cours : positive pour des victoires, negative pour des defaites.
  streak     Int @default(0)

  lastMatchAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, rating])
  @@map("rpg_arena_records")
}

/**
 * Journal d'un duel d'arene.
 *
 * Le defenseur n'est pas connecte quand le duel a lieu : ce journal est le seul moyen
 * pour lui de savoir qu'il a ete attaque, et par qui.
 */
model RpgArenaMatch {
  id      String @id @default(cuid())
  guildId String

  challengerId String
  opponentId   String
  winnerId     String

  /// Points echanges, toujours positifs : le gagnant les prend, le perdant les cede.
  ratingChange Int @default(0)
  challengerRatingAfter Int @default(0)
  opponentRatingAfter   Int @default(0)

  /// Recompense versee au vainqueur, en pieces.
  coinsAwarded Int @default(0)

  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, opponentId, createdAt])
  @@map("rpg_arena_matches")
}

/**
 * Avancement d'un joueur dans la campagne.
 *
 * La campagne est LINEAIRE : une seule etape active a la fois, ce que decrivent
 * `chapterId` + `stepIndex`. Un modele a etapes paralleles demanderait une table par
 * etape pour un scenario que personne n'a demande.
 *
 * Le contenu (chapitres, etapes, recompenses) est statique cote bot : `chapterId` refere
 * le catalogue sans cle etrangere, et un chapitre retire laisse une progression inerte
 * que la lecture sait reprendre au chapitre suivant.
 */
model RpgCampaignProgress {
  id      String @id @default(cuid())
  guildId String
  userId  String

  /// Chapitre en cours. Vide quand la campagne est terminee.
  chapterId String
  /// Index de l'etape en cours dans ce chapitre.
  stepIndex Int @default(0)
  /// Avancement sur l'objectif de l'etape en cours.
  counter   Int @default(0)

  /// Chapitres deja boucles, pour l'affichage et pour ne pas les rejouer.
  completedChapters String[] @default([])

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
  @@map("rpg_campaign_progress")
}

model RpgBattle {
  id          String   @id @default(cuid())
  guildId     String
  userId      String

  monsterId   String
  monsterName String
  won         Boolean

  damageDealt Int      @default(0)
  damageTaken Int      @default(0)
  xpEarned    Int      @default(0)
  coinsEarned Int      @default(0)
  itemDropped String?

  createdAt DateTime @default(now())

  guild   Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile RpgProfile @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  monster RpgMonster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@map("rpg_battles")
}

// ============================================================================
// PÊCHE
// ============================================================================

model RpgFishCatch {
  id        String   @id @default(cuid())
  guildId   String
  userId    String

  fishName  String
  fishEmoji String
  rarity    String   // COMMON | UNCOMMON | RARE | EPIC | LEGENDARY
  value     Int

  createdAt DateTime @default(now())

  guild   Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile RpgProfile @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@map("rpg_fish_catches")
}

/// Espèce de poisson propre à un serveur.
///
/// Les espèces livrées de base vivent dans le code (`rpgFishCatalog.ts`), pas en base : une
/// ligne du serveur portant le même nom les remplace, et `enabled = false` les retire. Le
/// nom est aussi la clé des prises (`RpgFishCatch.fishName`) : c'est lui qui conserve la
/// progression du carnet quand une espèce est personnalisée.
model RpgFish {
  id      String  @id @default(cuid())
  guildId String
  name    String
  emoji   String  @default("🐟")
  /// COMMON | UNCOMMON | RARE | EPIC | LEGENDARY
  rarity  String  @default("COMMON")
  value   Int     @default(5)
  xp      Int     @default(5)
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@map("rpg_fish")
}

/// Récompense d'un palier du carnet de pêche, réglée par le serveur.
///
/// Sans ligne, le palier verse la récompense par défaut du code : une ligne à zéro partout
/// est donc la seule façon de le rendre muet.
model RpgFishBookReward {
  id         String  @id @default(cuid())
  guildId    String
  /// Une rareté (COMMON...LEGENDARY) terminée, ou COMPLETE pour le carnet entier.
  tier       String
  coinReward Int     @default(0)
  xpReward   Int     @default(0)
  /// Points de clan, ou XP de guilde selon les équipes du serveur, comme les primes du bestiaire.
  clanPoints Int     @default(0)
  /// Objet désigné par son nom, comme les butins.
  itemName   String?
  roleId     String?
  titleId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title RpgTitle? @relation(fields: [titleId], references: [id], onDelete: SetNull)

  @@unique([guildId, tier])
  @@map("rpg_fishbook_rewards")
}

/// Palier du carnet déjà versé à un joueur. L'unicité empêche de toucher deux fois le même.
model RpgFishBookClaim {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  tier      String
  createdAt DateTime @default(now())

  profile RpgProfile @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@unique([guildId, userId, tier])
  @@map("rpg_fishbook_claims")
}

model EconomyConfig {
  guildId           String   @id
  enabled           Boolean  @default(false)
  rpgEnabled        Boolean  @default(false)
  guildsEnabled     Boolean  @default(false)
  shopEnabled       Boolean  @default(false)
  
  currencyName      String   @default("KotboCoins")
  currencyEmoji     String   @default("🪙")
  currencyIcon      String?
  dailyRewardMin    Int      @default(50)
  dailyRewardMax    Int      @default(150)
  dailyCooldownHour Int      @default(20) // Heures de recharge du /daily
  
  adventureCooldownMin Int   @default(30)  // Temps entre chaque aventure (en minutes)
  maxEnergy            Int   @default(100)
  energyRecoveryPerHour Int  @default(10)

  // Garde-fous anti-abus (gambling / transferts)
  maxBetAmount         Int   @default(1000) // Mise maximale autorisée pour dice/roulette/rps
  maxDailyBets         Int   @default(20)   // Nombre maximal de parties de jeux d'argent par jour et par membre
  maxTransferAmount    Int   @default(5000) // Montant maximal transférable en une fois via /rpg-pay
  transferCooldownMin  Int   @default(15)   // Temps minimum entre deux transferts (en minutes)

  // ── Marché noir ─────────────────────────────────────────────────────────
  // Une fenêtre d'ouverture courte, à heure imprévisible, où chaque membre se voit
  // proposer sa propre sélection d'objets de la boutique à prix cassé.
  blackMarketEnabled      Boolean @default(false)
  blackMarketIntervalDays Int     @default(7)   // Périodicité moyenne entre deux ouvertures
  blackMarketDurationMin  Int     @default(120) // Durée de la fenêtre d'ouverture, en minutes
  blackMarketOfferCount   Int     @default(4)   // Nombre d'offres tirées par membre
  blackMarketMaxQuantity  Int     @default(3)   // Achats maximum par offre
  blackMarketDiscountMin  Int     @default(20)  // Remise minimale appliquée, en pourcentage
  blackMarketDiscountMax  Int     @default(50)  // Remise maximale appliquée, en pourcentage
  // Annonce : NONE = découverte passive via le hub /rpg, CHANNEL = message public,
  // CHANNEL_ROLE = message public avec mention du rôle `blackMarketRoleId`.
  blackMarketAnnounce     String  @default("NONE")
  blackMarketChannelId    String?
  blackMarketRoleId       String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("economy_configs")
}

/// Fenêtre d'ouverture du marché noir, commune à tout le serveur. Les offres, elles,
/// sont tirées par membre (voir `RpgBlackMarketOffer`) : deux joueurs ne voient jamais
/// la même vitrine, ce qui évite la course au meilleur prix entre membres connectés.
model RpgBlackMarketSession {
  id          String    @id @default(cuid())
  guildId     String
  opensAt     DateTime
  closesAt    DateTime
  /// Renseigné une fois l'annonce publiée, pour ne jamais annoncer deux fois la même session.
  announcedAt DateTime?
  createdAt   DateTime  @default(now())

  offers RpgBlackMarketOffer[]
  guild  Guild                 @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, opensAt])
  @@index([guildId, closesAt])
  @@map("rpg_black_market_sessions")
}

/// Offre personnelle d'un membre pour une session donnée. Le prix remisé est figé au
/// tirage : une modification du prix boutique en cours de session ne peut pas rétroactivement
/// renchérir ni brader ce qui a été proposé au joueur.
model RpgBlackMarketOffer {
  id        String @id @default(cuid())
  sessionId String
  userId    String
  itemId    String
  price     Int
  discount  Int
  stock     Int    @default(1)
  purchased Int    @default(0)

  createdAt DateTime @default(now())

  session RpgBlackMarketSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    RpgItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, itemId])
  @@index([sessionId, userId])
  @@map("rpg_black_market_offers")
}

model RpgProfile {
  id        String   @id @default(cuid())
  guildId   String
  userId    String

  // Économie de base
  balance   Int      @default(0)
  lastDaily DateTime?
  lastWork  DateTime?

  // Statistiques RPG.
  // IMPORTANT : `attack`/`defense`/`speed`/`maxHealth` sont les stats de BASE du personnage
  // (niveaux + points investis). Les bonus d'équipement, d'amélioration et de classe sont
  // calculés à la lecture par `getEffectiveStats` et ne sont JAMAIS écrits ici.
  level     Int      @default(1)
  xp        Int      @default(0)
  health    Int      @default(100)
  maxHealth Int      @default(100)
  energy    Int      @default(100)
  attack    Int      @default(10)
  defense   Int      @default(10)
  speed     Int      @default(10)

  // Classe (WARRIOR | RANGER | MAGE), choisie à partir du niveau 5.
  className   String?
  // Points de caractéristiques gagnés à chaque niveau et non encore répartis.
  statPoints  Int      @default(0)

  // Équipement équipé
  weaponId  String?
  armorId   String?
  accessoryId String?
  potionId  String?

  // Niveau d'amélioration (forge) de l'équipement porté, de 0 à 10.
  weaponUpgrade    Int @default(0)
  armorUpgrade     Int @default(0)
  accessoryUpgrade Int @default(0)

  // Combat & Pêche
  totalMonstersKilled Int      @default(0)
  totalBossesKilled   Int      @default(0)
  totalFishCaught     Int      @default(0)
  lastFish            DateTime?
  lastBattle          DateTime?

  // État de voyage
  isTraveling    Boolean   @default(false)
  travelDestination String?
  travelDurationMin  Int      @default(0)
  travelStartedAt DateTime?
  lastEventAt     DateTime?
  lastTravelEndedAt DateTime? // Fin du dernier voyage résolu, sert de base au cooldown d'aventure

  // Régénération d'énergie : horodatage dédié, distinct de `updatedAt`, pour que
  // les actions qui ne touchent pas l'énergie (pay, gambling, etc.) ne remettent
  // pas à zéro la fenêtre de calcul de la régénération.
  lastEnergyTick DateTime? @default(now())

  // Anti-abus jeux d'argent (dice/roulette/rps) : fenêtre glissante de 24h
  dailyBetCount       Int       @default(0)
  dailyBetWindowStart DateTime?

  // Anti-abus transferts (/rpg-pay)
  lastTransferAt DateTime?

  // Relations
  rpgGuildId String?
  rpgGuild   RpgGuild? @relation(fields: [rpgGuildId], references: [id], onDelete: SetNull)
  inventory  RpgInventoryItem[]
  battles    RpgBattle[]
  fishCatches RpgFishCatch[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, balance])
  @@index([guildId, level, xp])
  @@map("rpg_profiles")
}

model RpgItem {
  id          String   @id @default(cuid())
  guildId     String?  // null = global (item par défaut du bot)
  name        String
  description String
  emoji       String   @default("📦")
  type        String   // WEAPON | ARMOR | ACCESSORY | POTION | MATERIAL | QUEST

  // Statistiques d'équipement/utilisation
  atkBonus    Int      @default(0)
  defBonus    Int      @default(0)
  spdBonus    Int      @default(0)
  hpBonus     Int      @default(0)  // PV maximum accordés par l'objet (accessoires surtout)
  hpRestore   Int      @default(0)
  energyRestore Int    @default(0)

  // Rareté et niveau requis
  rarity        String   @default("COMMON") // COMMON | UNCOMMON | RARE | EPIC | LEGENDARY
  levelRequired Int      @default(0)

  // Récompenses versées par les modules voisins à la consommation. Un objet qui en
  // porte disparaît de la boutique tant que le module correspondant est éteint : sans
  // ça, la boutique vendrait de l'XP à un serveur qui n'a pas de niveaux.
  levelXpReward    Int @default(0)
  clanPointsReward Int @default(0)

  // Prix d'achat en boutique
  price       Int      @default(0)
  purchasable Boolean  @default(true)
  /// Autorise le tirage de cet objet au marché noir. Les objets qui vendent une
  /// récompense de module en sortent par défaut : leur prix est un prix, pas une
  /// base de négociation à -50 %.
  blackMarketEligible Boolean @default(true)

  inventoryEntries  RpgInventoryItem[]
  recipes           RpgRecipe[]
  blackMarketOffers RpgBlackMarketOffer[]
  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId, type])
  @@map("rpg_items")
}

/// Recette d'artisanat : transforme des matériaux (drops de monstres, poissons…) en
/// équipement. C'est ce qui donne une utilité aux butins ramassés en combat.
model RpgRecipe {
  id           String  @id @default(cuid())
  guildId      String? // null = recette globale fournie de base
  resultItemId String
  /// [{ itemName: string, quantity: number }]
  ingredients  Json
  coinCost     Int     @default(0)
  levelRequired Int    @default(1)

  resultItem RpgItem @relation(fields: [resultItemId], references: [id], onDelete: Cascade)
  guild      Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("rpg_recipes")
}

model RpgInventoryItem {
  id           String   @id @default(cuid())
  rpgProfileId String
  itemId       String
  quantity     Int      @default(1)

  profile RpgProfile @relation(fields: [rpgProfileId], references: [id], onDelete: Cascade)
  item    RpgItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([rpgProfileId, itemId])
  @@map("rpg_inventory_items")
}

model RpgGuild {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  description String?
  emoji     String   @default("🛡️")
  ownerId   String   // Discord UserId du créateur
  
  level     Int      @default(1)
  xp        Int      @default(0)
  treasury  Int      @default(0)

  members   RpgProfile[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@map("rpg_guilds")
}

model RpgAdventureEvent {
  id          String   @id @default(cuid())
  guildId     String?  // null = global (évènements fournis de base)
  title       String
  description String   // Le texte de l'événement (ex: "Vous croisez un marchand suspect...")
  emoji       String   @default("🌲")

  // Choix possibles sous forme de JSON pour flexibilité (options, requis, effets)
  // Format : Array<{ text: string, hpEffect: number, coinEffect: number, xpEffect: number, minLevel: number }>
  choices     Json

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("rpg_adventure_events")
}

model RpgDrop {
  id        String   @id @default(cuid())
  guildId   String
  amount    Int
  type      String   // COINS | XP | ITEM
  itemId    String?  // Si type = ITEM
  claimed   Boolean  @default(false)
  claimedBy String?
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("rpg_drops")
}

// ============================================================================
// MONSTRES & COMBAT
// ============================================================================

model RpgMonster {
  id          String   @id @default(cuid())
  guildId     String?  // null = global (monstres par défaut)
  name        String
  description String
  emoji       String   @default("👹")

  level       Int      @default(1)
  health      Int      @default(50)
  attack      Int      @default(8)
  defense     Int      @default(5)
  speed       Int      @default(5)

  xpReward    Int      @default(20)
  coinReward  Int      @default(10)

  // Drops possibles : [{ itemName, emoji, chance (0-1), coinBonus? }]
  drops       Json     @default("[]")

  isBoss           Boolean @default(false)
  bossRespawnHours Int?

  /// Points de clan versés au vainqueur, quand le pont RPG vers les clans est
  /// ouvert (`Guild.clanPointsFromRpg`). À zéro, la créature ne rapporte rien
  /// au classement des clans.
  clanPoints Int @default(0)

  /// Un monstre global désactivé par un serveur est remplacé par une copie locale
  /// portant le même nom avec `enabled = false` : le catalogue global reste intact.
  enabled Boolean @default(true)

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  battles RpgBattle[]

  @@unique([guildId, name])
  @@map("rpg_monsters")
}

model RpgBattle {
  id          String   @id @default(cuid())
  guildId     String
  userId      String

  monsterId   String
  monsterName String
  won         Boolean

  damageDealt Int      @default(0)
  damageTaken Int      @default(0)
  xpEarned    Int      @default(0)
  coinsEarned Int      @default(0)
  itemDropped String?

  createdAt DateTime @default(now())

  guild   Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile RpgProfile @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  monster RpgMonster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@map("rpg_battles")
}

// ============================================================================
// PÊCHE
// ============================================================================

model RpgFishCatch {
  id        String   @id @default(cuid())
  guildId   String
  userId    String

  fishName  String
  fishEmoji String
  rarity    String   // COMMON | UNCOMMON | RARE | EPIC | LEGENDARY
  value     Int

  createdAt DateTime @default(now())

  guild   Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile RpgProfile @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@map("rpg_fish_catches")
}

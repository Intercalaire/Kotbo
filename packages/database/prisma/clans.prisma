// ============================================================================
// CLANS & CONTRIBUTIONS SCHEMA
// ============================================================================

model Clan {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  roleId      String   @unique // ID du rôle Discord unique associé
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  generalChannelId String?
  leaderRoleId     String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  contributions ClanMemberContribution[]
  contributionEvents ClanContributionEvent[]

  @@unique([guildId, name])
  @@map("clans")
}

model ClanMemberContribution {
  id        String   @id @default(cuid())
  guildId   String
  clanId    String
  userId    String
  xp        Int      @default(0) // Points accumulés dans ce clan pour cette saison
  season    Int      @default(1) // Numéro de la saison
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clan  Clan  @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([guildId, clanId, userId, season])
  // Rang d'un participant = nombre de contributions du même clan ayant plus de
  // points. Sans cet index, la recherche publique lit la saison entière.
  @@index([guildId, clanId, season, xp])
  @@map("clan_member_contributions")
}

// Journal des gains de points de clan (flux « derniers scores » temps réel).
// Contrairement à ClanMemberContribution (total agrégé par saison), cette table
// enregistre chaque gain individuel pour pouvoir afficher l'historique récent.
model ClanContributionEvent {
  id        String   @id @default(cuid())
  guildId   String
  clanId    String
  userId    String   // 'system_manual_points' = gain attribué au clan entier (à afficher au nom du clan)
  amount    Int      // Points gagnés lors de cet événement (peut être négatif si retrait)
  source    String   // 'XP' (gagné via progression) | 'ADMIN' (attribué manuellement par un admin)
  season    Int      @default(1)
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clan  Clan  @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  // Historique d'une personne dans la recherche publique : sans cet index, il
  // faut remonter le flux global jusqu'à trouver ses gains.
  @@index([guildId, userId, createdAt])
  @@map("clan_contribution_events")
}

/// Dette de points de clan d'un membre.
///
/// Ouverte quand un membre engage plus de points qu'il n'en a (paris à crédit),
/// elle est prélevée sur ses gains futurs avant tout crédit au classement.
///
/// Volontairement **sans saison** : une dette rattachée à la saison en cours
/// s'effacerait en attendant la clôture, ce qui reviendrait à offrir la mise à
/// qui parie au mauvais moment. Elle suit le membre jusqu'à remboursement.
///
/// Concept de la couche clans, pas des paris : c'est ce qui permet aux gains de
/// toutes origines (progression, boost, Daily Algo) de rembourser sans que les
/// clans aient à connaître le module qui a creusé la dette.
model ClanPointDebt {
  id      String @id @default(cuid())
  guildId String
  userId  String
  /// Toujours positif. La ligne est supprimée dès qu'elle retombe à zéro.
  amount  Int
  /// Origine de la dette, pour l'affichage : 'BET' aujourd'hui.
  source  String @default("BET")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, amount])
  @@map("clan_point_debts")
}

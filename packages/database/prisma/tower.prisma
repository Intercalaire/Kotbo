// ============================================================================
// LA TOUR (mode roguelite du RPG)
// ============================================================================

/// Réglages de la Tour d'un serveur.
///
/// La Tour a ses propres statistiques, son équipement et sa monnaie : rien de ce qu'on y
/// trouve ne rejoint le profil RPG, sinon les récompenses de la boutique et des paliers.
model RpgTowerConfig {
  guildId     String  @id
  enabled     Boolean @default(false)
  name        String  @default("La Tour")
  emoji       String  @default("")
  description String  @default("")

  /// COMPRESSED : les stats du RPG sont compressées (logarithme) puis plafonnées.
  /// RESET : tout le monde part des stats de base, seul le titre porté compte.
  entryMode      String @default("COMPRESSED")
  /// Bonus maximal hérité des stats du RPG, en pourcentage des stats de base de la Tour.
  inheritCapPercent Int @default(50)
  /// Bonus maximal accordé par le titre porté, en pourcentage des stats de base.
  titleCapPercent   Int @default(30)

  /// Croissance de la force des monstres à chaque étage, en pourcentage.
  floorGrowthPercent Int @default(8)
  bossEvery          Int @default(10)
  blessingEvery      Int @default(5)
  maxBlessings       Int @default(6)

  shardsPerFloor     Int @default(2)
  /// Part des éclats conservée après une mort, en pourcentage.
  deathShardPercent  Int @default(50)
  /// Part des éclats conservée en quittant la Tour hors palier sûr. Juste après un boss,
  /// quitter garde tout.
  leaveShardPercent  Int @default(80)
  /// Plafond d'éclats gagnés par semaine et par joueur. 0 = aucun plafond.
  weeklyShardCap     Int @default(0)
  idleTimeoutMinutes Int @default(30)

  currencyName  String @default("Éclats de Tour")
  currencyEmoji String @default("")

  /// Améliorations permanentes vendues contre des éclats (voir `TowerUpgradeDef`). `null` :
  /// les améliorations par défaut.
  upgrades Json?
  /// Prix et soins du marchand (voir `TowerMerchantSettings`). `null` : réglages par défaut.
  merchant Json?

  /// Étages dessinés depuis le dashboard, dans l'ordre de la montée (voir `rpgTowerMap.ts`).
  /// Tant que la carte n'est pas activée, la Tour tire ses portes au hasard.
  layoutEnabled Boolean @default(false)
  layouts       Json    @default("[]")
  /// Ancienne carte unique, d'avant les étages : relue comme premier étage si `layouts` est vide.
  layout        Json?

  /// Début de la saison en cours : le classement se lit sur `RpgTowerProfile.bestFloor`,
  /// remis à zéro à chaque nouvelle saison.
  seasonStartedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("rpg_tower_configs")
}

/// Récompense de la Tour versée au profil RPG : article de boutique payé en éclats, ou
/// palier atteint. Le titre est désigné sans clé étrangère : un titre supprimé laisse une
/// récompense inerte plutôt qu'une suppression en cascade silencieuse.
model RpgTowerReward {
  id          String  @id @default(cuid())
  guildId     String
  /// SHOP | MILESTONE
  kind        String
  name        String
  description String  @default("")
  emoji       String  @default("")
  /// Prix en éclats (SHOP).
  price       Int     @default(0)
  /// Étage à atteindre (MILESTONE).
  floor       Int     @default(0)
  /// Un article non répétable ne s'achète qu'une fois par joueur.
  repeatable  Boolean @default(false)

  titleId String?
  roleId  String?
  coins   Int     @default(0)
  /// XP du RPG (`RpgProfile.xp`), jamais celle du module de niveaux du serveur.
  xp      Int     @default(0)
  /// Points de clan, ou XP de guilde RPG selon le mode d'équipe du serveur.
  clanPoints Int  @default(0)
  /// Objet du catalogue désigné par son nom, comme les butins.
  itemName   String?
  /// Éclats versés par un palier.
  shards  Int     @default(0)

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, kind])
  @@map("rpg_tower_rewards")
}

/// Profil Tour d'un joueur, séparé du profil RPG.
model RpgTowerProfile {
  id      String @id @default(cuid())
  guildId String
  userId  String

  shards         Int @default(0)
  lifetimeShards Int @default(0)
  /// Meilleur étage de la saison en cours.
  bestFloor        Int       @default(0)
  bestFloorAt      DateTime?
  bestFloorAllTime Int       @default(0)
  totalRuns        Int       @default(0)

  weekShards Int       @default(0)
  weekStart  DateTime?

  /// Améliorations permanentes valables dans la Tour seulement : { potion: 1, vigor: 2 }.
  upgrades         Json     @default("{}")
  /// Paliers déjà versés et articles uniques déjà achetés.
  claimedRewardIds String[] @default([])
  /// Bilan d'une partie close en l'absence du joueur, affiché une fois à son retour.
  pendingSettlement Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  runs  RpgTowerRun[]

  @@unique([guildId, userId])
  @@index([guildId, bestFloor])
  @@map("rpg_tower_profiles")
}

/// Ascension en cours ou terminée. Tout l'état jetable (stats, équipement, bénédictions,
/// combat) vit dans `state` et disparaît avec la partie.
model RpgTowerRun {
  id        String @id @default(cuid())
  profileId String
  guildId   String
  userId    String

  /// ACTIVE | DEAD | LEFT
  status  String @default("ACTIVE")
  floor   Int    @default(1)
  /// Incrémenté à chaque action : un vieux bouton ou un double clic ne rejoue rien.
  version Int    @default(0)
  state   Json

  shardsEarned Int @default(0)

  startedAt    DateTime  @default(now())
  lastActionAt DateTime  @default(now())
  endedAt      DateTime?

  profile RpgTowerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([guildId, userId, status])
  @@map("rpg_tower_runs")
}

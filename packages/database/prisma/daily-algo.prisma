enum DailyAlgoSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  // Hors-sujet : aucun point, mais aucune sanction non plus. Sépare la tentative
  // maladroite (APPROVED + points plancher) du troll (REJECTED, sanctionnable).
  DISMISSED
}

model DailyAlgoProblem {
  id          String   @id @default(cuid())
  title       String
  description String
  solution    String
  difficulty  String   @default("moyen") // facile, moyen, difficile
  language    String   @default("fr")
  functionName String?
  functionArgs Json?
  unitTests Json?
  allowedLanguages String[] @default(["javascript"])
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs DailyAlgoRun[]

  @@map("daily_algo_problems")
  @@index([language])
  @@index([language, usedAt])
}

model DailyAlgoRun {
  id String @id @default(cuid())

  guildId String
  dateKey String?
  problemId String

  challengeChannelId String
  validationChannelId String?
  challengeMessageId String?
  leaderboardMessageId String?
  summarySentAt DateTime?

  // DAILY = défi ordinaire, WEEKEND = défi majoré du samedi/dimanche.
  kind String @default("DAILY")
  // Multiplicateur appliqué aux points de ce run (1 en semaine, 1.5 le week-end).
  // Figé au moment du tirage : changer le réglage ne réécrit pas les runs passés.
  pointsMultiplier Float @default(1)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  problem DailyAlgoProblem @relation(fields: [problemId], references: [id])
  submissions DailyAlgoSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_algo_runs")
  @@index([guildId, createdAt])
  @@unique([guildId, dateKey])
  // La recherche du probleme deja tire pour une date interroge `dateKey` seul,
  // tous serveurs confondus : la cle unique commence par `guildId` et ne peut
  // donc pas la servir, alors que la table gagne une ligne par serveur et par jour.
  @@index([dateKey])
}

model DailyAlgoSubmission {
  id String @id @default(cuid())

  runId String
  authorId String
  authorName String
  solution String

  status DailyAlgoSubmissionStatus @default(PENDING)
  validationMessageId String?
  validatedById String?
  validatedAt DateTime?

  submittedAt DateTime @default(now())
  speedRank Int?
  speedBonusPoints Float?

  scoreCorrectness Int?
  scoreComments Int?
  scoreCompactness Int?
  scoreOptimization Int?
  scoreReadability Int?
  scoreFinal Float?
  reviewFeedback String?

  // Total de points figé à la notation, déjà arrondi à l'unité supérieure.
  // Source de vérité des classements : `scoreFinal` reste la moyenne /5 affichée,
  // pas un nombre de points. Figer évite qu'un changement de barème réécrive
  // l'historique alors que des points de clan ont déjà été versés.
  pointsAwarded Int?

  // Signalé comme dérapage (contenu injurieux, code malveillant, plagiat...).
  abuseFlagged Boolean @default(false)
  abuseReason String?

  run DailyAlgoRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_algo_submissions")
  @@index([runId, status])
  @@index([authorId])
}

// ============================================================================
// SEMAINE COMPÉTITIVE
// ============================================================================

enum DailyAlgoWeekStatus {
  OPEN
  CLOSED
}

/// Une semaine de compétition Daily Algo par serveur. La clôture (cron du lundi
/// ou bouton d'administration) fige le classement et verse les récompenses.
model DailyAlgoWeek {
  id String @id @default(cuid())

  guildId String
  weekKey String // Semaine ISO, ex. « 2026-W31 »

  startsAt DateTime
  endsAt   DateTime

  status DailyAlgoWeekStatus @default(OPEN)

  // Classement archivé à la clôture : [{ rank, userId, userName, points, participations }]
  finalLeaderboard Json?

  closedAt DateTime?
  // Renseigné une fois les récompenses versées : sert de verrou d'idempotence
  // avec `DailyAlgoWeeklyReward` (un cron rejoué ne redistribue pas).
  rewardsGrantedAt DateTime?
  // Identifiant du membre ayant déclenché une clôture manuelle (null si cron).
  closedById String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rewards DailyAlgoWeeklyReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, weekKey])
  @@index([guildId, status])
  @@map("daily_algo_weeks")
}

/// Trace d'une récompense hebdomadaire versée à un membre. Sert d'idempotence
/// (unique par semaine et par membre) et de piste d'audit.
model DailyAlgoWeeklyReward {
  id String @id @default(cuid())

  weekId  String
  guildId String
  userId  String

  rank   Int // 1/2/3 pour le podium, 0 pour une récompense de participation
  points Int // Total de points Daily Algo de la semaine

  xpGranted         Int @default(0)
  clanPointsGranted Int @default(0)
  roleId            String?

  week DailyAlgoWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([weekId, userId])
  @@index([guildId, userId])
  @@map("daily_algo_weekly_rewards")
}

/// Points bonus attribués à la main par le staff (positifs ou négatifs).
/// Comptabilisés dans le classement hebdomadaire et le classement all-time.
model DailyAlgoBonusPoint {
  id String @id @default(cuid())

  guildId String
  userId  String
  amount  Int // Peut être négatif (retrait)
  reason  String
  grantedById String
  weekKey String // Semaine ISO d'imputation

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, weekKey])
  @@index([guildId, userId])
  @@map("daily_algo_bonus_points")
}

// ============================================================================
// MARKETPLACE - HÔTEL DES VENTES / MARCHÉ ENTRE JOUEURS
// ============================================================================

enum ListingType {
  FIXED_PRICE
  AUCTION
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

model MarketplaceListing {
  id String @id @default(cuid())

  guildId  String
  sellerId String

  itemId   String // Référence RpgItem
  quantity Int    @default(1)

  /// Progression de l'exemplaire vendu. Un exemplaire forgé ou enchanté se vend seul
  /// (quantité 1) et l'acheteur le reçoit tel quel ; à zéro, ce sont des exemplaires
  /// ordinaires, qui rejoignent la pile de l'acheteur.
  upgrade  Int  @default(0)
  enchants Json @default("[]")

  type     ListingType @default(FIXED_PRICE)
  status   ListingStatus @default(ACTIVE)

  price       Int // Prix fixe ou prix de départ pour enchères
  currentBid  Int? // Enchère actuelle
  bidderId    String? // Dernier enchérisseur

  expiresAt DateTime

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  transactions MarketplaceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@index([guildId, sellerId])
  @@index([guildId, expiresAt])
  @@map("marketplace_listings")
}

model MarketplaceTransaction {
  id String @id @default(cuid())

  guildId   String
  listingId String @unique
  sellerId  String
  buyerId   String
  itemId    String

  quantity  Int
  price     Int // Prix final payé
  /// Niveau de forge vendu : le prix moyen proposé à la mise en vente compare les ventes
  /// d'un même objet au même niveau.
  upgrade   Int @default(0)

  guild   Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, sellerId])
  @@index([guildId, buyerId])
  @@index([guildId, createdAt])
  @@index([guildId, itemId, createdAt])
  @@map("marketplace_transactions")
}

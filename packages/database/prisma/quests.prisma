// ============================================================================
// QUESTS - SYSTÈME DE QUÊTES QUOTIDIENNES/HEBDOMADAIRES
// ============================================================================

enum QuestFrequency {
  DAILY
  WEEKLY
}

enum QuestType {
  SEND_MESSAGES
  VOICE_MINUTES
  REACT_MESSAGES
  WIN_GAME
  EARN_COINS
  GIVE_REP
  CREATE_THREADS
  REPLY_MESSAGES
}

enum QuestProgressStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
  EXPIRED
}

model QuestDefinition {
  id String @id @default(cuid())

  guildId   String
  name      String
  description String

  type      QuestType
  frequency QuestFrequency @default(DAILY)

  // Objectif
  target    Int @default(1) // ex: 50 messages, 30 minutes, etc.

  // Récompenses
  rewardCoins Int @default(0)
  rewardXp    Int @default(0)

  // Activation
  enabled   Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  progress QuestProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, enabled])
  @@index([guildId, frequency])
  @@map("quest_definitions")
}

model QuestProgress {
  id String @id @default(cuid())

  guildId  String
  userId   String
  questId  String
  dateKey  String // YYYY-MM-DD (pour daily) ou YYYY-Www (pour weekly)

  current  Int @default(0)
  target   Int
  status   QuestProgressStatus @default(IN_PROGRESS)

  claimedAt DateTime?

  guild Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  quest QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId, questId, dateKey])
  @@index([guildId, userId, status])
  @@index([guildId, dateKey])
  @@map("quest_progress")
}

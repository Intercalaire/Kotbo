enum InterestDecision {
  ALLOWED
  FILTERED_OUT
}

enum ItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model NewsArticle {
  id String @id @default(cuid())

  guildId String
  title String
  content String
  summary String?
  imageUrl String?

  authorId String
  authorName String
  authorAvatar String?

  isGlobal Boolean @default(true)
  category String @default("Mise à jour")
  subcategory String @default("")
  published Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  publishedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, publishedAt])
  @@index([isGlobal, publishedAt])
  @@map("news_articles")
}

model NewsCategoryConfig {
  id String @id @default(cuid())

  guildId String
  category String
  subcategory String @default("")
  channelId String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, category, subcategory])
  @@map("news_category_configs")
}


model YoutubeChannelFollow {
  id String @id @default(cuid())
  guildId String
  channelId String
  channelName String

  // Un seul salon de destination pour tous les types d'alertes
  discordChannelId String?
  // Un seul rôle/utilisateur à mentionner pour tous les types d'alertes
  mention String?

  // Message personnalisé par type d'événement (variables [title] / [channel])
  liveMessage String?
  videoMessage String?
  shortMessage String?

  lastLiveId String?
  lastVideoId String?
  lastShortId String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId])
  @@map("youtube_channel_follows")
}

model TwitchChannelFollow {
  id String @id @default(cuid())
  guildId String
  streamerName String
  streamerId String?

  discordChannelId String?
  mention String?
  liveMessage String?

  isLive Boolean @default(false)
  lastStreamId String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, streamerName])
  @@map("twitch_channel_follows")
}

/// Dépôt GitHub suivi : commits d'une branche, releases, pull requests et issues.
model GithubRepoFollow {
  id String @id @default(cuid())
  guildId String
  /// `owner/repo` en minuscules : sert de clé de dédoublonnage entre serveurs.
  repo String
  /// Branche des commits ; null = branche par défaut du dépôt.
  branch String?

  discordChannelId String?
  mention String?

  notifyCommits Boolean @default(true)
  notifyReleases Boolean @default(true)
  notifyPullRequests Boolean @default(false)
  notifyIssues Boolean @default(false)

  // Message personnalisé par type d'événement (variables [title] / [channel] / [url])
  commitMessage String?
  releaseMessage String?
  pullRequestMessage String?
  issueMessage String?

  // Dernier élément vu par type : null tant que le premier passage n'a pas
  // posé la référence, pour ne pas annoncer tout l'historique à l'ajout.
  lastCommitSha String?
  lastReleaseId String?
  lastPullNumber Int?
  lastIssueNumber Int?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, repo])
  @@index([repo])
  @@map("github_repo_follows")
}

/// Suivi Hugging Face : un dépôt (modèle, dataset, space) et ses commits, ou un
/// auteur et les dépôts qu'il publie.
model HuggingFaceFollow {
  id String @id @default(cuid())
  guildId String
  /// MODEL, DATASET, SPACE (commits d'un dépôt) ou AUTHOR (nouveaux dépôts).
  kind String
  /// `owner/nom` pour un dépôt, nom d'utilisateur ou d'organisation pour un auteur.
  target String

  discordChannelId String?
  mention String?
  message String?

  /// Dernier commit vu (dépôt) ou date de création du dernier dépôt vu (auteur).
  lastCommitId String?
  lastCreatedAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, kind, target])
  @@index([kind, target])
  @@map("huggingface_follows")
}

model Feed {
  id String @id @default(cuid())
  guildId String
  name String
  url String
  category String
  language String?
  enabled Boolean @default(true)
  autoPublish Boolean @default(false)
  includeKeywords String[] @default([])
  excludeKeywords String[] @default([])
  ignoredKeywords String[] @default([])

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  items FeedItem[]
  subscribers FeedSubscriber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@map("feeds")
}

model FeedItem {
  id String @id @default(cuid())
  feedId String
  title String
  titleTranslated String?
  interestScore Float?
  interestDecision InterestDecision @default(ALLOWED)
  interestReason String?
  topics String[] @default([])
  status ItemStatus @default(PENDING)

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feed_items")
}

model FeedSubscriber {
  id String @id @default(cuid())
  feedId String
  userId String

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feedId, userId])
  @@map("feed_subscribers")
}
